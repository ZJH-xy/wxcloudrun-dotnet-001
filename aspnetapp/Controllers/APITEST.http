@localhost = https://localhost:63295
@id = 1
@phone = 13000000000
@password = 1

### id 获取用户”基础信息”
GET {{localhost}}/user/i/{{id}} HTTP/1.1


### phone 获取用户”基础信息”
GET {{localhost}}/user/p/{{phone}} HTTP/1.1


###
GET {{localhost}}/user/a/{{id}} HTTP/1.1
content-type: application/json

{
    "Password": "{{password}}"
}

### phone/password，登录
GET {{localhost}}/user/l/{{phone}} HTTP/1.1
content-type: application/json

{
    "Password": "{{password}}"
}

### code，如未注册则创建用户，反之则返回用户“基础信息”
# POST {{localhost}}/user/ql/1 HTTP/1.1


### phone 获取用户收藏门店
#GET {{localhost}}/user/f/s/{{phone}} HTTP/1.1


### ======================== 门店 ===========================
### 获取所有门店信息
GET {{localhost}}/store/a HTTP/1.1


### ======================== 车辆 ===========================
### StoreId 获取门店所有车辆
GET {{localhost}}/vehicle/a HTTP/1.1


### 
GET {{localhost}}/vehicle/1 HTTP/1.1


### ======================== 订单 ===========================
### StoreId 查询单个订单
GET {{localhost}}/order/i/{{id}} HTTP/1.1


### StoreId 添加单个订单
POST {{localhost}}/order/a HTTP/1.1
content-type: application/json

{
    "TheUser": 1,
    "UserName": "测试用户001",
    "UserPhone": "13666666666",
    "IdentityCard": "360000000000000000",
    "Vehicle": 1,
    "StartingTime": "2024-10-23",
    "ExpectedReturnTime": "2024-10-24",
    "RentalLocation": 1,
    "LongTermLease": false,
    "Deposit": 200,
    "Rent": 30,
    "Notes": "备注"
}