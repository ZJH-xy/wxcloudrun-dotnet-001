@page
@model aspnetapp.Pages.Admin.homeModel
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Server
@{
	ViewData["Title"] = "租赁后台管理";
	Layout = "_Layout";
}
<!-- navbar.html -->
<!DOCTYPE html>
<html lang="zh">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="~/css/main.css" />
	<script src="~/js/main.js"></script>
	<!-- 引入 FontAwesome 图标库 -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

</head>

<body>

	<!-- 侧边栏区域 -->
	<nav>
		<!-- 侧边栏收起/展开按钮 -->
		<div class="sidebar-toggle" onclick="toggleSidebar()">
			<i class="fas fa-bars"></i> <!-- 你可以使用图标库如 FontAwesome -->
		</div>
		<div class="sidebar">
			<div class="header">
				<h3>租赁系统后台</h3>
				<!-- 显示登录的管理员信息 -->
				<div class="admin-info">
					<span>管理员：</span> <!-- 显示管理员名称 -->
					<a href="/admin/logout" class="logout-link">退出登录</a> <!-- 提供退出登录的链接 -->
				</div>
			</div>
			<ul class="menu">
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/news-paper.png"></image>
						<span>&nbsp概览</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#" onclick="loadPage('统计数据', this)">
								<image src="/images/icon/queue.png"></image>
								<span>&nbsp统计数据</span>
							</a>
						</li>
					</ul>
				</li>
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/travel-car.png"></image>
						<span>&nbsp车辆管理</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#" onclick="loadPage('车辆总览', this)">
								<image src="/images/icon/queue.png"></image>
								<span>&nbsp车辆总览</span>
							</a>
						</li>
					</ul>
				</li>
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/shopping-cart.png"></image>
						<span>&nbsp订单管理</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#" onclick="loadPage('订单总览', this)">
								<image src="/images/icon/queue.png"></image>
								<span>&nbsp订单总览</span>
							</a>
						</li>
					</ul>
				</li>
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/store-front.png"></image>
						<span>&nbsp门店管理</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#" onclick="loadPage('门店总览', this)">
								<image src="/images/icon/queue.png"></image>
								<span>&nbsp门店总览</span>
							</a>
						</li>
						<li>@* 
							<a href="#" onclick="loadPage('申请审核', this)">
								<image src="/images/icon/queue.png"></image>
								<span>&nbsp申请审核</span>
							</a>
						</li> *@
					</ul>
				</li>
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/user-group.png"></image>
						<span>&nbsp用户管理</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#"  onclick="loadPage('用户总览', this)">
								<image src="/images/icon/queue.png"></image>
								<sapn>&nbsp用户总览</sapn>
							</a>
						</li>
					</ul>
				</li>
				<li>
					<a href="#" onclick="toggleSubMenu(event)">
						<image src="/images/icon/document.png"></image>
						<span>&nbsp首页管理</span>
						<div class="arrow"></div>
					</a>
					<ul>
						<li>
							<a href="#" onclick="loadPage('广告总览', this)">
								<image src="/images/icon/document.png"></image>
								<span>&nbsp广告总览</span>
							</a>
						</li>
						<li>
							<a href="#" onclick="loadPage('公告总览', this)">
								<image src="/images/icon/document.png"></image>
								<span>&nbsp公告总览</span>
							</a>
						</li>
					</ul>
				</li>
			</ul>
		</div>
	</nav>

	<!-- 主内容区域 -->
	<div class="main-content">
		@* 根据选择的页面动态加载内容 *@
		<iframe id="contentFrame" src="about:blank"></iframe>
	</div>


</body>
</html>


