@page
@model LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = "_Layout";
}
 
<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/loading.css" />

    <script src="~/js/loading.js" defer></script>

    <style>
        body {
            height: 100vh; /* 视窗高度 */
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background-color: rgba(226,239,245);
        }

        .login {
            background-color: rgba(255, 255, 255, 0.8); 
            box-shadow: 3px 3px 12px rgba(0, 0, 0, 0.4); /* 阴影 */
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 10px;
            width: 350px;
        }

        h2 {
            color: #080510;
            text-align: center;
            margin-bottom: 20px;
            font-weight: bold; /* 加粗字体 */
        }

        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
        }

        input[type="submit"] {
            width: 100%;
            padding: 10px;
            margin-top: 16px;
            background-color: #2657d0;
            border: none;
            border-radius: 6px;
            color: #e8e8e8;
            cursor: pointer;
            font-size: 16px;
        }

        input[type="submit"]:hover {
            background-color: #2a64f4;
            color: white; /* 将文本颜色变淡 */
            box-shadow: 3px 8px 8px rgba(0, 0, 0, 0.3); /* 阴影 */
            transform: translateY(-2px); /* 向上移动 */
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease; /* 添加过渡动画 */
        }

        .login-form .input-group i {
            position: absolute;
            top: 50%;
            left: 10px;
            transform: translateY(-50%);
            color: #888;
        }

        .login-form .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .login-form input[type="text"],
        .login-form input[type="password"] {
            width: 100%;
            padding: 10px 15px 10px 35px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            color: #333;
            box-sizing: border-box;
        }

            .login-form input[type="text"]:focus,
            .login-form input[type="password"]:focus {
                border-color: #007bff;
                outline: none;
            }

        .input-group {
            display: flex;
            align-items: center;
            position: relative;
        }

            .input-group input {
                flex: 1;
                padding-right: 40px; /* 预留空间用于按钮 */
            }

        .toggle-password-btn {
            position: absolute;
            right: 30px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
            color: #666;
            padding: 5px;
        }

            .toggle-password-btn:focus {
                outline: none;
            }

    </style>
</head>
<body>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)){
        <div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors)){
            <div id="failMessage" class="failMessage">@error.ErrorMessage</div>
        }
        <script>
            setTimeout(function () {
                showMessage("failMessage", 5000);
            }, 100)
        </script>
    }
    <div class="login">
        <h2>租赁系统后台登录</h2>
        <form method="post" class="login-form">
            <!-- 用户名输入 -->
            <div class="input-group">
                <i class="fa fa-user"></i>
                <input type="text" name="Username" placeholder="请输入用户名" required />
            </div>
            <!-- 密码输入 -->
            <div class="input-group">
                <i class="fas fa-lock"></i>
                <input type="password" id="Password" name="Password" placeholder="请输入密码" required />
                <button type="button" id="togglePassword" class="toggle-password-btn">
                    <i class="fas fa-eye"></i>
                </button>
                <script>
                    const passwordInput = document.getElementById("Password");
                    const togglePasswordButton = document.getElementById("togglePassword");
                    togglePasswordButton.addEventListener("click", function () {
                        const type = passwordInput.getAttribute("type") === "password" ? "text" : "password"; // 切换密码框的 type 属性
                        passwordInput.setAttribute("type", type);
                        this.innerHTML = type === "password" ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>'; // 切换按钮图标
                    });
                </script>
            </div>
            <input type="submit" value="登录" />
        </form>
    </div>

    <script>
        document.getElementById("loginForm").addEventListener("submit", async function (event) {
            event.preventDefault(); // 防止表单默认提交

            const username = document.getElementById("username").value;
            const password = document.getElementById("password").value;

            try {
                const response = await fetch(window.location.href, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ username, password }),
                });

                if (response.ok) {
                    const data = await response.json();
                    localStorage.setItem("jwt", data.jwt); // 保存 JWT 到 localStorage
                    window.location.href = "/admin/main"; // 跳转到目标页面
                } else {
                    const errorText = await response.text();
                    document.getElementById("errorMessage").innerText = "登录失败: " + errorText;
                }
            } catch (error) {
                document.getElementById("errorMessage").innerText = "发生错误: " + error.message;
            }
        });
    </script>
</body>
</html>