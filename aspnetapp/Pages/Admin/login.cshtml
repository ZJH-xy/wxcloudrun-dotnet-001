@page
@model LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = "_Layout";
}
 
<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background-image: url('/images/background.jpg'); /* 设置背景图片的路径 */
            background-size: cover; /* 背景图片覆盖整个页面 */
            background-position: center;
            background-repeat: no-repeat;
            height: 100vh; /* 视窗高度 */
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
        }

        .login-container {
            background-color: rgba(255, 255, 255, 0.4); /* 半透明白色背景 */
            box-shadow: 14px 18px 12px rgba(0, 0, 0, 0.4); /* 阴影 */
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: 10px;
            width: 350px;
        }

        h2 {
            color: #080510;
            text-align: center;
            margin-bottom: 20px;
            font-weight: bold; /* 加粗字体 */
        }

        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
        }

        input[type="submit"] {
            width: 100%;
            padding: 10px;
            margin-top: 16px;
            background-color: #2657d0;
            border: none;
            border-radius: 6px;
            color: #e8e8e8;
            cursor: pointer;
            font-size: 16px;
        }

        input[type="submit"]:hover {
            background-color: #2a64f4;
            color: white; /* 将文本颜色变淡 */
            box-shadow: 3px 8px 8px rgba(0, 0, 0, 0.3); /* 阴影 */
            transform: translateY(-2px); /* 向上移动 */
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease; /* 添加过渡动画 */
        }

        #errorMessage {
            padding-top: 10px;
            text-align: center;
            color: #ff0000;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>系统后台</h2>
        <form method="post">
            <input type="text" name="Username" placeholder="用户名" required />
            <input type="password" name="Password" placeholder="密码" required />
            <input type="submit" value="登录" />
        </form>
        <p id="errorMessage">@Model.ErrorMessage</p>
    </div>
</body>
</html>