@page
@model aspnetapp.Pages.Admin.Subpages.VehicleManagement.VehicleOverviewModel
@{
}
<link rel="stylesheet" href="~/css/table.css" />
<div>
    <!-- 显示错误消息 -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
        <div class="alert alert-danger">
            <ul>
                <li>@Model.ErrorMessage</li>
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- 显示成功消息 -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
        <div class="alert alert-success">
            <p>@Model.SuccessMessage</p>
        </div>
    }

    <!-- 页面顶部操作栏 -->
    <form method="get" class="header">
        <div class="header-item">
            <button type="submit">刷新</button>
            <button>添加</button>
            <button>导出</button>
        </div>
    </form>


    <form method="post" asp-page-handler="Search">

        <button type="submit">搜索</button>
    </form>

    <!-- 车辆列表表格 -->
    <table id="vehicleTable">
        <thead>
            <tr>
                <th>序号</th>
                <th>ID</th>
                <th>车牌号</th>
                <th>车架号</th>
                <th>合格证</th>
                <th>行驶证</th>
                <th>发票</th>
                <th>购入登记时间</th>
                <th>车辆型号</th>
                <th>车辆状态</th>
                <th>创建时间</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.List.Count; i++) {
                <tr>
                    <form method="post" asp-page-handler="UpdateVehicle">
                    <td>@(i + 1)</td>
                    <td>@Model.List[i].Id</td>
                    <input type="hidden" name="UpdatedVehicle.Id" value="@Model.List[i].Id" />
                    <td><input type="text" name="UpdatedVehicle.PlateNumber" value="@Model.List[i].PlateNumber" placeholder="无" /></td>
                    <td><input type="text" name="UpdatedVehicle.FrameNumber" value="@Model.List[i].FrameNumber" placeholder="无" /></td>
                    <td><input type="text" name="UpdatedVehicle.Certificate" value="@Model.List[i].Certificate" placeholder="无" /></td>
                    <td><input type="text" name="UpdatedVehicle.Drivinglicense" value="@Model.List[i].Drivinglicense" placeholder="无" /></td>
                    <td><input type="text" name="UpdatedVehicle.Invoice" value="@Model.List[i].Invoice" placeholder="无" /></td>
                    <td><input type="date" name="UpdatedVehicle.PurchaseRegistrationTime" value="@Model.List[i].PurchaseRegistrationTime.ToString()" /></td>
                    <td><input type="text" name="UpdatedVehicle.State" value="@Model.List[i].State" placeholder="无" /></td>
                    <td>
                        <select name="UpdatedVehicle.Status">
                            <option value="空闲" selected="@(Model.List[i].State == 0 ? "selected" : null)">空闲</option>@* 
                            <option value="已出租" selected="@(Model.List[i].State == 1 ? "selected" : null)">已出租</option>
                            <option value="充电中" selected="@(Model.List[i].State == 2 ? "selected" : null)">充电中</option> *@
                        </select>
                    </td>

                    <td>@Model.List[i].CreatedAt</td>
                    <td>
                        <button type="submit">保存</button>
                    </td>
                    <input type="hidden" name="UpdatedVehicle.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
                    </form>
                </tr>
            }
        </tbody>
    </table>

    <!-- 分页控件 -->
    <div class="bottom">
        <div class="bottom-item">
            <text>第 @(Model.PageIndex) 页，共 * 页</text>
        </div>
        <div class="bottom-item">
            @* <input asp-for="PageNumber" placeholder="请输入页数" /> *@
            <input placeholder="请输入页数" />
            <button asp-page-handler="JumpToPage">跳转</button>
            <button asp-page-handler="PreviousPage">上一页</button>
            <button asp-page-handler="NextPage">下一页</button>
        </div>
    </div>
</div>


<script>
    // 获取模态窗口
    var modal = document.getElementById("myModal");
    var span = document.getElementById("closeBtn");

    // 使用事件委托
    document.getElementById("userTable").addEventListener("click", function (event) {
        if (event.target.classList.contains("modalBtn")) {
            modal.style.display = "block";
        }
    });

    // 点击关闭按钮时关闭模态窗口
    span.onclick = function () {
        modal.style.display = "none";
    }

    // 点击模态窗口外部时关闭模态窗口
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>