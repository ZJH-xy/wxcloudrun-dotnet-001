@page
@model aspnetapp.Pages.Admin.Subpages.VehicleManagement.VehicleOverviewModel
@{

}

<head>
    <meta charset="utf-8" />
    <!-- 引用外部 jQuery -->
    <link rel="stylesheet" href="~/css/table.css" />
    <link rel="stylesheet" href="~/css/loading.css" />
    <script src="~/js/utils/jquery-3.6.0.min.js" defer></script>
    <script src="~/js/loading.js" defer></script>
</head>
<header>
    <h3>车辆总览</h3>
</header>
<body>

    <!-- 加载动画 -->
    <div class="box" id="loadding" style="display:none;">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>
    <!-- 锁住页面的遮罩层 -->
    <div id="overlay" style="display:none;"></div>

    <!-- 显示错误消息 -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
        {
            <div id="failMessage" class="failMessage">@error.ErrorMessage</div>
        }
        <script>
            setTimeout(function () {
                showMessage("failMessage",  5000);
            }, 500)
        </script>
    }

    <!-- 显示成功消息 -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div id="successMessage" class="message">@Model.SuccessMessage</div>
        <script>
            setTimeout(function () {
                showMessage("successMessage", 5000);
            }, 500)
        </script>
    }

    <div class="header">
        <div class="header">
            <form method="get">
                <button type="submit">刷新</button>
            </form>

            <button onclick="exportFile()" class="editBtn export">导出</button>
            <button onclick="showAddRowDataBtn()">添加</button>

        </div>
        <form method="post" asp-page-handler="Search">
            <input asp-for="SearchPlateNumberHtml" id="SearchPlateNumberHtml" value="" placeholder="车牌号" />
            <input asp-for="SearchOwnerHtml" id="SearchOwnerHtml" value="" placeholder="车主" />

            <select asp-for="SortFieldHtml" id="SortFieldHtml">
                <option value="Id">车辆ID</option>
                <option value="platenumber">车牌号</option>
                <option value="createdat">创建时间</option>
                <option value="updatedAt">更新时间</option>
            </select>
            <select asp-for="SortOrderHtml" id="SortOrderHtml">
                <option value="asc">升序</option>
                <option value="desc">降序</option>
            </select>
            <button type="submit" onclick="confirmChangeSearchData()">搜索</button>
        </form>
    </div>
    <div class="table-container">
        <table id="userTable">
            <tr>
                <th>序号</th>
                <th>车辆ID</th>
                <th>所属门店名称（ID）</th>
                <th>当前所在门店名称（ID）</th>
                <th>车牌号</th>
                <th>车架号</th>
                <th>合格证</th>
                <th>行驶证</th>
                <th>发票</th>
                <th>购入登记时间</th>
                <th>车主</th>
                <th>介绍</th>
                <th>是否涉案</th>
                <th>车辆型号</th>
                <th>车辆图片</th>
                <th>状态修改</th>
                <th>创建时间</th>
                <th>更新时间</th>
                <th>操作</th>
            </tr>
            <form method="post" asp-page-handler="AddVehicle">
            <td style="display:none;" id="autoGenerated1">自动生成</td>
            <td style="display:none;" id="autoGenerated2">自动生成</td>
            <td style="display:none;" id="TheOriginalStore">
                <input asp-for="NewVehicle.TheOriginalStore" placeholder="所属门店ID" />
                <span asp-validation-for="NewVehicle.TheOriginalStore"></span>
            </td>
            <td style="display:none;" id="TheCurrentStore">
                <input asp-for="NewVehicle.TheCurrentStore" placeholder="当前所在门店ID" />
                <span asp-validation-for="NewVehicle.TheCurrentStore"></span>
            </td>
            <td style="display:none;" id="PlateNumber">
                <input asp-for="NewVehicle.PlateNumber" placeholder="车牌号" />
                <span asp-validation-for="NewVehicle.PlateNumber"></span>
            </td>
            <td style="display:none;" id="FrameNumber">
                <input asp-for="NewVehicle.FrameNumber" placeholder="车架号" />
                <span asp-validation-for="NewVehicle.FrameNumber"></span>
            </td>
            <td style="display:none;" id="Certificate">
                <span style="color:gray;">合格证</span>
                <select id="selecCertificate" name="NewVehicle.Certificate">
                    <option value=false>无</option>
                    <option value=true>有</option>
                </select>
                <span asp-validation-for="NewVehicle.Certificate"></span>
            </td>
            <td style="display:none;" id="Drivinglicense">
                <span style="color:gray;">行驶证</span>
                <select id="selecDrivinglicense" name="NewVehicle.Drivinglicense">
                    <option value=false>无</option>
                    <option value=true>有</option>
                </select>
                <span asp-validation-for="NewVehicle.Drivinglicense"></span>
            </td>
            <td style="display:none;" id="Invoice">
                <span style="color:gray;">发票</span>
                <select id="selecInvoice" name="NewVehicle.Invoice">
                    <option value=false>无</option>
                    <option value=true>有</option>
                </select>
                <span asp-validation-for="NewVehicle.Drivinglicense"></span>
            </td>
            <td style="display:none;" id="PurchaseRegistrationTime">
                <input asp-for="NewVehicle.PurchaseRegistrationTime" placeholder="购入登记时间" type="datetime-local" />
                <span asp-validation-for="NewVehicle.PurchaseRegistrationTime"></span>
            </td>
            <td style="display:none;" id="Owner">
                <input asp-for="NewVehicle.Owner" placeholder="车主" />
                <span asp-validation-for="NewVehicle.Owner"></span>
            </td>
            <td style="display:none;" id="VehicleIntroduction">
                <textarea asp-for="NewVehicle.VehicleIntroduction" placeholder="介绍" type="text" value=""></textarea>
                <span asp-validation-for="NewVehicle.VehicleIntroduction"></span>
            </td>
            <td style="display:none;" id="IsCase">
                <input asp-for="NewVehicle.IsCase" placeholder="是否涉案" />
                <span asp-validation-for="NewVehicle.IsCase"></span>
            </td>
            <td style="display:none;" id="Model">
                <select id="selectModel" name="NewVehicle.Model">
                    <!-- 空闲状态 -->
                    <option value="0">其他</option>
                    <!-- 已出租状态 -->
                    <option value="1">雅迪</option>
                    <!-- 充电中状态 -->
                    <option value="2">爱玛</option>
                    <!-- 故障状态 -->
                    <option value="3">台铃</option>
                </select>
                <span asp-validation-for="NewVehicle.State"></span>
            </td>
            <td style="display:none;" id="uploadStatus">添加成功后上传</td>

            <td style="display:none;" id="State">
                <select id="selectState" name="NewVehicle.State">
                    <!-- 空闲状态 -->
                    <option value="0">空闲</option>
                    <!-- 已出租状态 -->
                    <option value="1">已出租</option>
                    <!-- 充电中状态 -->
                    <option value="2">充电中</option>
                    <!-- 故障状态 -->
                    <option value="3">故障</option>
                    <!-- 锁定状态 -->
                    <option value="4">锁定</option>
                    <!-- 待确认状态 -->
                    <option value="5">待确认</option>
                </select>
                <span asp-validation-for="NewVehicle.State"></span>
            </td>
            <td style="display:none;" id="autoGenerated4">自动生成</td>
            <td style="display:none;" id="autoGenerated5">自动生成</td>
            <td style="display:none;" id="submitButton">
                <button type="submit">添加</button>
            </td>
            </form>
            @for (int i = 0; i < Model.List.Count; i++)
            {
                <tr>
                    <form method="post" asp-page-handler="UpdateVehicle" enctype="multipart/form-data">
                    <td>@(i + 1)</td>
                    <td><span id="@("id" + i)">@Model.List[i].Id</span><input type="hidden" name="UpdatedVehicle.Id" value="@Model.List[i].Id" /></td>

                    <td>
                        <span>@Model.List[i].OriginalStoreName</span><br />
                        <div style="color:rgb(168,0,0)">
                            ID:<input id="@("TheOriginalStore" + i)" type="text" name="UpdatedVehicle.TheOriginalStore" value="@Model.List[i].TheOriginalStore" placeholder="无" disabled style="width:30%;" />
                        </div>
                    </td>
                    <td>
                        <span>@Model.List[i].CurrentStoreName</span><br />
                        <div style="color:rgb(168,0,0)">
                            ID:<input id="@("TheCurrentStore" + i)" type="text" name="UpdatedVehicle.TheCurrentStore" value="@Model.List[i].TheCurrentStore" placeholder="无" disabled style="width:30%;" />
                        </div>
                    </td>

                    <td><input id="@("plateNumber" + i)" type="text" name="UpdatedVehicle.PlateNumber" value="@Model.List[i].PlateNumber" placeholder="无" disabled /></td>
                    <td><input id="@("frameNumber" + i)" type="text" name="UpdatedVehicle.FrameNumber" value="@Model.List[i].FrameNumber" placeholder="无" disabled /></td>
                    <td><!--合格证-->
                            @if (Model.List[i].Certificate.HasValue && Model.List[i].Certificate.Value)
                            {
                            <span name="UpdatedVehicle.Certificate" style="color:#07C160;">有</span>
                            }
                            else
                            {
                            <span>无</span>
                            }
                        <select id="selecCertificate" name="UpdatedVehicle.Certificate" disabled style="display:none;">
                            <option value=@Model.List[i].Certificate>默认值</option>
                            <option value=false>无</option>
                            <option value=true>有</option>
                        </select>
                    </td>
                    <td><!--行驶证-->
                            @if (Model.List[i].Drivinglicense.HasValue && Model.List[i].Drivinglicense.Value)
                            {
                            <span name="UpdatedVehicle.Drivinglicense" style="color:#07C160;">有</span>
                            }
                            else
                            {
                            <span>无</span>
                            }
                        <select id="selecDrivinglicense" name="UpdatedVehicle.Drivinglicense" disabled style="display:none;">
                            <option value=@Model.List[i].Drivinglicense>默认值</option>
                            <option value=false>无</option>
                            <option value=true>有</option>
                        </select>
                    </td>
                    <td>
                        <!--发票-->
                            @if (Model.List[i].Invoice.HasValue && Model.List[i].Invoice.Value)
                            {
                            <span name="UpdatedVehicle.Invoice" style="color:#07C160;">有</span>
                            }
                            else
                            {
                            <span>无</span>
                            }
                        <select id="selecInvoice" name="UpdatedVehicle.Invoice" disabled style="display:none;">
                            <option value=@Model.List[i].Invoice>默认值</option>
                            <option value=false>无</option>
                            <option value=true>有</option>
                        </select>
                    </td>
                    <td><!--登记购入时间-->
                            @if (Model.List[i].PurchaseRegistrationTime.HasValue)
                            {
                                var formattedDateTime = Model.List[i].PurchaseRegistrationTime.Value.ToString("yyyy-MM-ddTHH:mm");
                            <input type="datetime-local" name="UpdatedVehicle.PurchaseRegistrationTime" value="@formattedDateTime" placeholder="无" style="width:100%;" readonly id="purchaseRegistrationTime_@Model.List[i].Id" />
                            }
                            else
                            {
                            <input type="datetime-local" name="UpdatedVehicle.PurchaseRegistrationTime" value="" placeholder="无" style="width:100%;" readonly id="purchaseRegistrationTime_@Model.List[i].Id" />
                            }
                    </td>

                    <td><input id="@("Owner" + i)" type="text" name="UpdatedVehicle.Owner" value="@Model.List[i].Owner" placeholder="无" disabled /></td>
                        <td><textarea id="@("VehicleIntroduction" + i)" type="text" name="UpdatedVehicle.VehicleIntroduction" value="@Model.List[i].VehicleIntroduction" disabled style="width:100px;">@Model.List[i].VehicleIntroduction</textarea></td>

                    <td>
                            @if (Model.List[i].IsCase)
                            {
                            <span name="UpdatedVehicle.IsCase" style="color:red;">是</span>
                            }
                            else
                            {
                            <span>否</span>
                            }
                        <select id="IsCase" name="UpdatedVehicle.IsCase" disabled style="display:none;">
                            <option value=@Model.List[i].IsCase>默认值</option>
                            <option value=false>否</option>
                            <option value=true>是</option>
                        </select>
                    </td>

                    <td>
                        <span id="model_@Model.List[i].Id" name="UpdatedVehicle.Model">@Model.List[i].Model</span>
                        <select id="selecModel" name="UpdatedVehicle.Model" disabled style="display:none;">
                            <option value="@Model.List[i].Model">@Model.List[i].Model</option>

                                @if (Model.List[i].Model != Vehicle.Emodel.未知)
                                {
                                <option value="0">其他</option>
                                }
                                @if (Model.List[i].Model != Vehicle.Emodel.雅迪)
                                {
                                <option value="1">雅迪</option>
                                }
                                @if (Model.List[i].Model != Vehicle.Emodel.爱玛)
                                {
                                <option value="2">爱玛</option>
                                }
                                @if (Model.List[i].Model != Vehicle.Emodel.台铃)
                                {
                                <option value="3">台铃</option>
                                }
                        </select>
                    </td>
                    <td>
                        <div class="imageContainer" data-id="@Model.List[i].Id">
                            <!-- 常驻显示的图片 -->
                            <div style="display:flex;align-items: center; justify-content: center; ">
                                <img src="" alt="图片加载失败"
                                     id="imageUrl"
                                     style="width: 100px; height: auto; cursor: pointer;display:none;"
                                     class="thumbnail"
                                     data-id="@Model.List[i].Id"
                                     onclick="openModal(this)">

                            </div>

                            <!-- 查看图片 -->
                                @if (!@Model.List[i].Pictures.IsNullOrEmpty())
                                {
                                <a href="#" id="@("getImageUrl" + i)" data-id="@Model.List[i].Pictures" onclick="loadImageUrl(event)">点击加载图片</a>
                                <div id="message" class="message">加载成功</div>

                                }
                                else
                                {
                                    <text>无图片</text>
                                }
                            <!-- 修改图片 -->
                            <div style="display:flex;align-items: center; justify-content: center; ">
                                <input value="@Model.List[i].Id" id="userId" style="display:none;" />
                                <input type="file" id="@("fileInput"+ i)" value="true" name="file" style="display: none;" class="fileUpload" data-id="@Model.List[i].Id">
                            </div>
                            <div style="display:flex;align-items: center; justify-content: center; ">

                                <!-- 编辑的图片预览 -->
                                <img src="" alt="预览图" class="preview" style="display: none; width: 100px; height: auto; margin-top: 10px;">

                            </div>
                            <!-- 图片模态窗口 -->
                            <div id="imageModal" class="modal" style="display:none;">
                                <span class="close" onclick="closeModal()">&times;</span>
                                <img class="modal-content" id="modalImage" />
                            </div>
                        </div>
                    </td>
                    <td>
                        <div id="state_@Model.List[i].Id">
                                @if (Model.List[i].State == Vehicle.Estates.空闲)
                                {
                                <span name="UpdatedVehicle.State" style="color:#07C160;">空闲</span>
                                }
                                else if (Model.List[i].State == Vehicle.Estates.已出租)
                                {
                                <span name="UpdatedVehicle.State">已出租</span>
                                }
                                else if (Model.List[i].State == Vehicle.Estates.充电中)
                                {
                                <span name="UpdatedVehicle.State" style="color:#FFC300;">充电中</span>
                                }
                                else if (Model.List[i].State == Vehicle.Estates.故障)
                                {
                                <span name="UpdatedVehicle.State" style="color:red;">故障</span>
                                }
                                else if (Model.List[i].State == Vehicle.Estates.锁定)
                                {
                                <span name="UpdatedVehicle.State" style="color:gray;">锁定</span>
                                }
                                else if (Model.List[i].State == Vehicle.Estates.侍确认)
                                {
                                <span name="UpdatedVehicle.State" style="color:#6467F0;">侍确认</span>
                                }
                        </div>
                        <select id="selectState" name="UpdatedVehicle.State" disabled style="display:none;">
                            <option value="@Model.List[i].State">@Model.List[i].State</option>
                            <!-- 空闲状态 -->
                                @if (@Model.List[i].State != Vehicle.Estates.空闲)
                                {
                                <option value="0">空闲</option>
                                }
                            <!-- 已出租状态 -->
                                @if (Model.List[i].State != Vehicle.Estates.已出租)
                                {
                                <option value="1">已出租</option>
                                }
                            <!-- 充电中状态 -->
                                @if (Model.List[i].State != Vehicle.Estates.充电中)
                                {
                                <option value="2">充电中</option>
                                }
                            <!-- 故障状态 -->
                                @if (Model.List[i].State != Vehicle.Estates.故障)
                                {
                                <option value="3">故障</option>
                                }
                            <!-- 锁定状态 -->
                                @if (Model.List[i].State != Vehicle.Estates.锁定)
                                {
                                <option value="4">锁定</option>
                                }
                            <!-- 待确认状态 -->
                                @if (Model.List[i].State != Vehicle.Estates.侍确认)
                                {
                                <option value="5">待确认</option>
                                }
                        </select>
                    </td>
                    <td><text id="@("createdAt" + i)">@Model.List[i].CreatedAt</text></td>
                    <td><text id="@("updatedAt" + i)">@Model.List[i].UpdatedAt</text></td>
                    <td>
                        <button type="button" class="editBtn" data-id="@Model.List[i].Id" onclick="enableEdit('@Model.List[i].Id')">编辑</button>
                        <button id="@("save" + i)" type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="saveClick(event)">保存</button>
                        <button id="@("delete" + i)" type="button" class="deleteBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="confirmDelete(event)">删除</button>
                        <script>
                            function enableEdit(id) {
                                var inputField = document.getElementById('purchaseRegistrationTime_' + id);
                                var state = document.getElementById('state_' + id);
                                var model = document.getElementById('model_' + id);
                                if (inputField) {
                                    inputField.removeAttribute('readonly'); // 取消只读属性
                                }
                                if (state) {
                                    state.style.display = "none"
                                }
                                if (model) {
                                    model.style.display = "none"
                                }
                            }
                        </script>
                    </td>
                    <input type="hidden" name="UpdatedVehicle.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />

                    </form>
                </tr>
            }



        </table>

    </div>
    @if (Model.List.Count == 0)
    {
        <span style="width: 100%;display:flex;justify-content: center;">当前页无任何数据!</span>
    }
    <div class="bottom">
        <div class="bottom-item">
            <span id="page">第 * 页</span>
            <span>，当前页共 @Model.List.Count 条数据</span>
            @* <span id="isSearch" style="display:none;" >，共搜索到 @Model.SearchSum 条数据，</span> *@
            @if (@Model.SearchSum != 0) {
                <span>，共搜索到 @Model.SearchSum 条数据</span>
            }
            <input id="SearchSum" value="@Model.SearchSum" style="display:none;" />
            <input id="PageCount" value="@Model.List.Count" style="display:none;" />
            <input id="PageLimit" value="@Model.Limit" style="display:none;" />

            <span id="pageSum"></span>
            <a href="#" id="pageSumButton" onclick="loadPageSum()" style="font-size:small;">显示总页数</a>
        </div>

        <div class="bottom-item">

            <form method="post" asp-page-handler="Search" id="pageForm">
                <input placeholder="请输入页数" id="redirect" />
                <button type="button" onclick="changePage(3)" class="editBtn">跳转</button>
                <button type="button" onclick="changePage(2)" class="editBtn">首页</button>
                <button type="button" onclick="changeEndPage()" class="editBtn">尾页</button>
                <button type="button" onclick="changePage(0)">上一页</button>
                <button type="button" onclick="changePage(1)">下一页</button>
                <span id="paginationTips" style="color: red; display: none; font-size: 14px; margin-top: 10px;"></span>

            </form>
        </div>
    </div>

    <script>
        // 页面加载完成后执行函数
        window.onload = function () {
            getSearchData();// 获取搜索框数据
            loadIndexPage();// 加载页码
            loadButton();// 加载按钮
            // updateSearchSummary();
        };
    </script>
    <script>

        const RESPONSEURL = `/Admin/Subpages/VehicleManagement/VehicleOverview`;
        const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const LENGTH = document.getElementById('PageCount').value;// 显示长度
        var file;
        var fileId;
        // 监听每行的文件是否有变化
        for (var i = 0; i < LENGTH; i++) {
            document.getElementById('fileInput' + i).addEventListener('change', function (event) {
                if (event.target.files[0]) {
                    file = event.target.files[0]; // 获取用户上传的文件
                    console.log('myFile', file)
                    const fileSize = file.size; // 单位为字节
                    const maxSize = 1 * 1024 * 1024; // 设置最大大小为 1MB
                    if (fileSize > maxSize) {
                        alert('文件过大，请上传小于 1MB 的图片。'); // 弹出提示框
                    }
                }
            });
        }

        // 处理删除按钮点击事件
        async function confirmDelete(event) {

            // 弹出确认框
            const isConfirmed = confirm("确定要删除吗？");

            if (isConfirmed) {
                // 使用 event.target 获取被点击的按钮元素
                const button = event.target;
                // 获取 data-id 属性的值
                const deleteId = button.getAttribute('data-id');
                console.log('确认删除,ID:' + deleteId)
                loadHTML();
                const requestData = {
                    id: deleteId
                };
                console.log("requestData...", requestData);

                try {
                    const response = await fetch(`${RESPONSEURL}?handler=Del`, {
                        method: 'Delete',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': TOKEN // 添加 CSRF Token
                        },
                        body: JSON.stringify(requestData), // 将数据序列化为 JSON 格式
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP 错误！状态码: ${response.status}`);
                    }

                    const data = await response.json();  // 等待接口返回数据

                    if (data.success) {
                        console.log("删除成功，message:", data.message);
                        location.reload();

                    } else {
                        console.log("删除失败，message:", data.message);
                    }

                } catch (error) {
                    console.error("API 调用失败:", error);
                } finally {
                    cancelloadHTML();
                }

            }
        }


        // 添加一行数据
        function showAddRowDataBtn() {
            // 获取表单内所有的 <td> 元素
