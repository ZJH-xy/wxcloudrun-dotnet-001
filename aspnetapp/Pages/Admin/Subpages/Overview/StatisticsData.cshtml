    <script>
        function changeIframeSrc(newSrc) {
            // 获取父页面 iframe 元素
            // 注意：只能通过同源策略访问父页面的元素
            if (window.parent) {
                window.parent.document.getElementById('contentFrame').src = newSrc; 
            } else {
                console.log("不能访问父页面");
            }
        }
    </script>
    <script>
        // 等待数据加载完成
        window.onload = async function () {
            loadHTML(); // 显示加载中
            await getRevenueData();
            await getOrderData();
            await getUserData();
            await getVehicleStateDistributionData();
            await getStoreData();
            cancelloadHTML();// 取消显示加载中

        };
        const RESPONSEURL = `/Admin/Subpages/Overview/StatisticsData`;

        // 获取订单趋势数据
        async function getRevenueData(event) {
            // loadHTML(); // 显示加载中
            console.log("开始调用接口...");
            const response = await fetch(`${RESPONSEURL}?handler=RevenueTrends`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',

                },
            });

            if (!response.ok) {
                throw new Error(`HTTP 错误！状态码: ${response.status}`);
            }

            const data = await response.json();  // 等待接口返回数据

            if (data.success) {
                // cancelloadHTML();// 取消显示加载中
                const sourceData = JSON.parse(data.revenueTrends)
                console.log("接口返回数据:", sourceData);
                const data1 = [];
                const data2 = [];
                sourceData.forEach(item => {
                    data1.push(item.Item1);
                    data2.push(item.Item2);
                });
                // 反转数据
                var reversedLabels = data1.reverse(); // 反转时间标签
                var reversedData = data2.reverse(); // 反转增长数据

                // 销售统计折线图
                var ctx1 = document.getElementById('salesChart').getContext('2d');
                var salesChart = new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: reversedLabels,
                        datasets: [{
                            label: '销售额',
                            data: reversedData,
                            borderColor: 'rgba(75, 192, 192, 1)',
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 5, // 增加点的半径
                            pointBackgroundColor: 'rgba(75, 192, 192, 1)', // 点的颜色
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                borderColor: 'rgba(75, 192, 192, 1)',
                                borderWidth: 2
                            },
                            legend: {
                                display: true,
                                position: 'top'
                            }
                        }
                    }
                });

            }

        }

