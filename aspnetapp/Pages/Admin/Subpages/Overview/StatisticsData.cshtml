            });

            if (!response.ok) {
                throw new Error(`HTTP 错误！状态码: ${response.status}`);
            }

            const data = await response.json();  // 等待接口返回数据

            if (data.success) {
                // cancelloadHTML(); // 取消显示加载中
                const sourceData = JSON.parse(data.vehicleStateDistribution);
                console.log("接口返回数据:", sourceData);

                const labels = [];
                const values = [];

                // 定义状态与颜色的映射
                const statusColors = {
                    "空闲": "#07C160",      // 绿色
                    "已出租": "#FF9800",    // 橙色
                    "充电中": "#2196F3",    // 蓝色
                    "故障": "#F44336",      // 红色
                    "锁定": "#9E9E9E",      // 灰色
                    "待确认": "#FFC107"     // 黄色
                };

                // 提取状态和对应值
                sourceData.forEach(item => {
                    labels.push(item.Item1); // Item1 是状态名称
                    values.push(item.Item2);  // Item2 是状态值
                });

                // 构建颜色数组
                const backgroundColors = labels.map(label => statusColors[label] || "#000000"); // 默认颜色

                // 车辆状态分布饼图
                var ctx5 = document.getElementById('vehicleStatusChart').getContext('2d');
                var vehicleStatusChart = new Chart(ctx5, {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: backgroundColors,
                            hoverBackgroundColor: backgroundColors
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                borderColor: 'rgba(75, 192, 192, 1)',
                                borderWidth: 2
                            },
                            legend: {
                                display: true,
                                position: 'top'
                            }
                        }
                    }
                });
            }
        }
