        // 获取车辆状态数据
        async function getVehicleStateDistributionData(event) {
            // loadHTML(); // 显示加载中
            console.log("开始调用接口...");
            const response = await fetch(`${RESPONSEURL}?handler=VehicleStateDistribution`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
