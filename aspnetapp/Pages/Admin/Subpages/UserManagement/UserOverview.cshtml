        @for (int i = 0; i < Model.List.Count; i++) {
            <tr>
                <form method="post" asp-page-handler="UpdateUser" enctype="multipart/form-data">
                <td>@(i + 1)</td>
                <td>@Model.List[i].Id<input type="hidden" name="UpdatedUser.Id" value="@Model.List[i].Id" /></td>
                <td><input type="text" name="UpdatedUser.Nickname" value="@Model.List[i].Nickname" placeholder="无" disabled /></td>
                <td><input type="text" name="UpdatedUser.Name" value="@Model.List[i].Name" placeholder="无" disabled /></td>
                <td><input type="text" name="UpdatedUser.Phone" value="@Model.List[i].Phone" placeholder="无" disabled /></td>
                <td><input type="text" name="UpdatedUser.IdentityCard" value="@Model.List[i].IdentityCard" placeholder="无" disabled /></td>
                <td>
                    <div class="imageContainer" data-id="@Model.List[i].Id">
                        <!-- 当前图片 -->
                        <img src="@Model.List[i].IdentityCardPictures" alt="图片加载失败"
                             style="width: 100px; height: auto; cursor: pointer;"
                             class="thumbnail"
                             data-id="@Model.List[i].Id"
                             onerror="this.style.display='none';">
                        <!-- 文件上传控件 -->
                        <label for="fileInput"></label>

                        <input type="file" id="fileInput" name="file" style="display: none;" class="fileUpload" data-id="@Model.List[i].Id" required>

                        <!-- 图片预览 -->
                        <img src="" alt="预览图" class="preview" style="display: none; width: 100px; height: auto; margin-top: 10px;">
                    </div>
                </td>

                <td>@Model.List[i].CreatedAt</td>

                <td>
                    <button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
                    <button type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="buttonClick()">保存</button>
                </td>

                <input type="hidden" name="UpdatedUser.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
                </form>
            </tr>
        }
        <script>
            var file;
            document.getElementById('fileInput').addEventListener('change', function (event) {
                file = event.target.files[0]; // 获取用户上传的文件
                console.log('myFile', file)

            });


            async function buttonClick() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                console.log("开始调用接口...");
                fetch('/Admin/Subpages/UserManagement/UserOverview?handler=SayHello', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token // 添加 CSRF Token
                    },
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP 错误！状态码: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log("接口返回数据:", data);
                        if (data.success) {
                            alert("文件上传成功！\n" +
                                "Image URL: " + data["imageUrl"] + "\n" +
                                "File Path: " + data["filePath"]) + "\n:" + data;
                        } else {
                            alert("文件上传失败: " + (data.message || "未知错误"));
                        }


                        console.log("=================================");

                        try {

                            console.log("++++++++++++++++++++++++++++++++=");
                            const fileInput = $('#fileInput')[0];

                            // if (!fileInput.files.length) {
                            //     alert('Please select a file.');
                            //     return;
                            // }


                            // 调用示例
                            const data2 = new FormData();
                            data2.append("key", data["filePath"]);
                            data2.append("Signature", data["authorization"]);
                            data2.append("x-cos-security-token", data["token"]);
                            data2.append("x-cos-meta-fileid", data["cos_file_id"]);
                            data2.append("file", file, file.name);

                            try {
                                const response = uploadFileSync(data["imageUrl"], data2);
                                console.log("Upload success:", response);
                            } catch (error) {
                                console.error("Error during upload:", error);
                            }


                            console.log("结束结束结束结束结束结束结束结束结束结束");



                            const form = new FormData();
                            form.append("key", data["filePath"]);
                            form.append("Signature", data["authorization"]);
                            form.append("x-cos-security-token", data["token"]);
                            form.append("x-cos-meta-fileid", data["cos_file_id"]);
                            form.append("file", fileInput.files[0], file.name);

                            console.log("data" + data["filePath"]);
                            console.log(form);

                            const settings = {
                                "url": data["imageUrl"],
                                "method": "POST",
                                "timeout": 0,
                                "headers": {
                                    "User-Agent": "Apifox/1.0.0 (https://apifox.com)",
                                    "Accept": "*/*",
                                    "Host": "7072-prod-3g2khb36f729f21f-1331625129.cos.ap-shanghai.myqcloud.com",
                                    "Connection": "keep-alive"
                                },
                                "processData": false,
                                "mimeType": "multipart/form-data",
                                "contentType": false,
                                "data": form
                            };
                            console.log("-------------------------------------");

                            $.ajax(settings).done(function (response) {
                                console.log(response);
                                $('#response').text('File uploaded successfully: ' + response);
                            }).fail(function (xhr, status, error) {
                                console.error(error);
                                $('#response').text('Error uploading file: ' + error);
                            });

                            console.log("调用结束...");
                        } catch (error) {
                            console.log("error" + error)
                        }

                    })

            }
            
            function uploadFileSync(url, data) {
                const xhr = new XMLHttpRequest();
                xhr.open("POST", url, false); // 第三个参数为 false，表示同步请求

                try {
                    xhr.send(data); // 发送 FormData 数据

                    if (xhr.status >= 200 && xhr.status < 300) {
                        return xhr.responseText; // 返回成功的响应
                    } else {
                        throw new Error(`HTTP error! Status: ${xhr.status}, Response: ${xhr.responseText}`);
                    }
                } catch (error) {
                    console.error("File upload failed:", error);
                    throw error; // 抛出错误，供调用者处理
                }
            }
        </script>

    </table>
    <div class="bottom">
        <div class="bottom-item">
            <text>第 @(Model.PageIndex) 页，共 * 页</text>
        </div>
        <div class="bottom-item">
            <input placeholder="请输入页数" />
            <button>跳转</button>
            <button>上一页</button>
            <button>下一页</button>
        </div>
    </div>

    <!-- 图片模态窗口 -->
    <div id="imageModal" class="modal" style="display:none;">
        <span class="close">&times;</span>
        <img class="modal-content" id="modalImage" />
    </div>

