@page
@model aspnetapp.Pages.Admin.Subpages.UserManagement.UserOverviewModel
@{
}
<link rel="stylesheet" href="~/css/table.css" />
<body>
	<h4>用户总览</h4>
	<!-- 显示错误消息 -->
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
		<div class="alert alert-danger">
			<ul>
				<text>@Model.ErrorMessage</text>
				@foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
					<li>@error.ErrorMessage</li>
				}
			</ul>
		</div>
	}

	<!-- 显示成功消息 -->
	@if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
		<div class="alert alert-success">
			<text>@Model.SuccessMessage</text>
		</div>
	}

	<div class="header">
		<div class="header">
			<form method="get">
				<button type="submit">刷新</button>
			</form>
			<button>导出</button>
			<button id="addRowBtn">添加</button>
		</div>
		<form method="post" asp-page-handler="Search">
			<input asp-for="SearchPhone" placeholder="手机号" />
			<input asp-for="SearchName" placeholder="姓名" />
			<input asp-for="SearchNickname" placeholder="昵称" />
			<select asp-for="SortField">
				<option value="Id">ID</option>
				<option value="Phone">手机号</option>
				<option value="Name">姓名</option>
				<option value="CreatedAt">创建时间</option>
			</select>
			<select asp-for="SortOrder">
				<option value="asc">升序</option>
				<option value="desc">降序</option>
			</select>
			<button type="submit">搜索</button>
		</form>



		<script type="text/javascript">
			function JsCallCSharp(param1) {
				PageMethods.sayhell(param1, onSayHelloSucceeded);
			}

			function onSayHelloSucceeded(result) {
				alert(result);
			}
		</script>


		<form id="form1" runat="server">
			<asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true"></asp:ScriptManager>
			<div>
				<input type="button" onclick="JsCallCSharp('hello')" value="调用C#方法" />
			</div>
		</form>



	</div>

	<table id="userTable">
		<tr>
			<th>序号</th>
			<th>ID</th>
			<th>昵称</th>
			<th>姓名</th>
			<th>手机号</th>
			<th>身份证号</th>
			<th>身份证照片</th>
			<th>创建时间</th>
			<th>操作</th>
		</tr>
		<!-- 新增数据行 -->
		<tr id="newRow" style="display: none;">
			<form method="post" asp-page-handler="AddVehicle">
			<td>新增</td>
			<td>自动生成</td>
			<td><input type="text" name="NewUser.Nickname" placeholder="请输入昵称" /></td>
			<td><input type="text" name="NewUser.Name" placeholder="请输入姓名" /></td>
			<td><input type="text" name="NewUser.Phone" placeholder="请输入手机号" /></td>
			<td><input type="text" name="NewUser.IdentityCard" placeholder="请输入身份证号" /></td>
			<td>
				<!-- 隐藏文件输入框 -->
				<input type="file" id="fileInput" name="NewVehicle.Image" accept="image/*" style="display: none;" />

				<!-- 自定义按钮 -->
				<button type="button" id="customButton">上传图片</button>

				<!-- 图片预览 -->
				<div id="previewContainer" style="margin-top: 10px;align-items: center; display:flex;flex-direction: column;">
					<img id="imagePreview" src="" style="display:none;width:100%;height:auto;" />
					<span id="fileName" style="display: block; color: #555; font-size: 14px;">未选择文件</span>
				</div>
			</td>



			<td>自动生成</td>
			<td>
				<button type="submit">保存</button>
			</td>
			</form>
		</tr>
		@for (int i = 0; i < Model.List.Count; i++) {
			<tr>
				<form method="post" asp-page-handler="UpdateUser" enctype="multipart/form-data" id="uploadForm">
				<td>@(i + 1)</td>
				<td>@Model.List[i].Id<input type="hidden" name="UpdatedUser.Id" value="@Model.List[i].Id" /></td>
				<td><input type="text" name="UpdatedUser.Nickname" value="@Model.List[i].Nickname" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.Name" value="@Model.List[i].Name" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.Phone" value="@Model.List[i].Phone" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.IdentityCard" value="@Model.List[i].IdentityCard" placeholder="无" disabled /></td>
				<td>
					<div class="imageContainer" data-id="@Model.List[i].Id">
						<!-- 当前图片 -->
						<img src="@Model.List[i].IdentityCardPictures" alt="图片加载失败"
							 style="width: 100px; height: auto; cursor: pointer;"
							 class="thumbnail"
							 data-id="@Model.List[i].Id"
							 onerror="this.style.display='none';">
						<!-- 文件上传控件 -->
						<input type="file" id="fileInput" name="UpdatedUser.IdentityCardPicture file" style="display: none;" class="fileUpload" data-id="@Model.List[i].Id">

						<!-- 图片预览 -->
						<img src="" alt="预览图" class="preview" style="display: none; width: 100px; height: auto; margin-top: 10px;">
					</div>
				</td>

				<td>@Model.List[i].CreatedAt</td>

				<td>
					<button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
					<button type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;">保存</button>
				</td>
				  
				<input type="hidden" name="UpdatedUser.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
				</form>
			</tr>
		}

	</table>
	<div class="bottom">
		<div class="bottom-item">
			<text>第 @(Model.PageIndex) 页，共 * 页</text>
		</div>
		<div class="bottom-item">
			<input placeholder="请输入页数" />
			<button>跳转</button>
			<button>上一页</button>
			<button>下一页</button>
		</div>
	</div>

	<!-- 图片模态窗口 -->
	<div id="imageModal" class="modal" style="display:none;">
		<span class="close">&times;</span>
		<img class="modal-content" id="modalImage" />
	</div>
	<!-- 图片操作相关 -->
	<script>
		const myFile = document.getElementById('fileInput');
		const file = myFile.files[0];
		const config = {
			key: @Model.ImageName,
			Signature: @Model.Authorization,
			token: @Model.Token,
			fileid: @Model.Cos_file_id,
			filePath: @Model.FilePath,
			url: @Model.FilePath
		}
		console.log('config:', config)

		$(document).ready(function () {
			$('#uploadForm').on('submit', function (event) {
				event.preventDefault();

				const fileInput = $('#fileInput')[0];
				if (!fileInput.files.length) {
					alert('Please select a file.');
					return;
				}

				const form = new FormData();
				form.append("key", config.key);
				form.append("Signature", config.Signature);
				form.append("x-cos-security-token", config.token);
				form.append("x-cos-meta-fileid", config.fileid);
				form.append("file", fileInput.files[0], config.filePath);

				const settings = {
					"url": config.url,
					"method": "POST",
					"timeout": 0,
					"headers": {
						"User-Agent": "Apifox/1.0.0 (https://apifox.com)",
						"Accept": "*/*",
						"Host": "7072-prod-3g2khb36f729f21f-1331625129.cos.ap-shanghai.myqcloud.com",
						"Connection": "keep-alive"
					},
					"processData": false,
					"mimeType": "multipart/form-data",
					"contentType": false,
					"data": form
				};

				$.ajax(settings).done(function (response) {

					console.log(response);
					$('#response').text('File uploaded successfully: ' + response);
				}).fail(function (xhr, status, error) {

					console.error(error);
					$('#response').text('Error uploading file: ' + error);
				});
			});
		});
	</script>
	<script src="~/js/PageUtils.js"></script>

</body>
