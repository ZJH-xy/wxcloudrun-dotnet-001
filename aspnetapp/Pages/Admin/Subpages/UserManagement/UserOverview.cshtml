@page
@model aspnetapp.Pages.Admin.Subpages.UserManagement.UserOverviewModel
@{
}
<link rel="stylesheet" href="~/css/table.css" />
<div>
    <div class="header">
        <div class="header-item">
            <button>刷新</button>
            <button>添加</button>
            <button>导出</button>
        </div>        
        <div class="header-item">
            <input placeholder="搜索"/>
            <button>搜索</button>
        </div>
    </div>

    <table id="userTable">
        <tr>
            <th>序号</th>
            <th>ID</th>
            <th>姓名</th>
            <th>手机号</th>
            <th>身份证号</th>
            <th>身份证照片</th>
            <th>创建时间</th>
            <th>操作</th>

        </tr>

        @for (int i = 0; i < @Model.List.Count; i++)
        {
            <tr>
                <td>@(i+1)</td>
                <td>@Model.List[i].Id</td>
                <td>@Model.List[i].Phone</td>
                <td>@Model.List[i].Name</td>
                <td>@Model.List[i].IdentityCard</td>
                <td>@Model.List[i].IdentityCardPictures</td>
                <td>@Model.List[i].CreatedAt</td>
                <td><button class="modalBtn">编辑</button></td>
            </tr>
        }
    </table>
    <div class="bottom">
        <div class="bottom-item">
            <text>显示第 1 到第 10 条记录，总共 100 条记录</text>
        </div>
        <div class="bottom-item">
            <input placeholder="请输入页数" />
            <button>跳转</button>
            <button>上一页</button>
            <button>下一页</button>
        </div>
    </div>

    <!-- 模态窗口 -->
    <div class="modal" id="myModal">
        <div class="modal-content">
            <span class="close" id="closeBtn">&times;</span>
            <h2>模态窗口</h2>
            <p>这是一个弹出的模态窗口。</p>
        </div>
    </div>
</div>
<script>
    // 获取模态窗口
    var modal = document.getElementById("myModal");
    var span = document.getElementById("closeBtn");

    // 使用事件委托
    document.getElementById("userTable").addEventListener("click", function (event) {
        if (event.target.classList.contains("modalBtn")) {
            modal.style.display = "block";
        }
    });

    // 点击关闭按钮时关闭模态窗口
    span.onclick = function () {
        modal.style.display = "none";
    }

    // 点击模态窗口外部时关闭模态窗口
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>