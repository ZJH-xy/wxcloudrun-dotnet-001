@page
@model aspnetapp.Pages.Admin.Subpages.UserManagement.UserOverviewModel
@{
}

<head>
	<meta charset="utf-8" />
	<!-- 引用外部 jQuery -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<link rel="stylesheet" href="~/css/table.css" />
	 <script src="~/js/pageutils.js"></script> 

</head>
<body>
	<h4>用户总览</h4>
	<!-- 显示错误消息 -->
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
		<div class="alert alert-danger">
			<ul>
				<text>@Model.ErrorMessage</text>
				@foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
					<li>@error.ErrorMessage</li>
				}
			</ul>
		</div>
	}

	<!-- 显示成功消息 -->
	@if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
		<div class="alert alert-success">
			<text>@Model.SuccessMessage</text>
			<text id="response"></text>

		</div>
	}

	<div class="header">
		<div class="header">
			<form method="get">
				<button type="submit">刷新</button>
			</form>
			<button>导出</button>
			<button id="addRowBtn">添加</button>
		</div>
			<form method="post" asp-page-handler="Search">
				<input asp-for="SearchPhone" placeholder="手机号" />
				<input asp-for="SearchName" placeholder="姓名" />
				<input asp-for="SearchNickname" placeholder="昵称" />
				<select asp-for="SortField">
					<option value="Id">ID</option>  
					<option value="Phone">手机号</option>
					<option value="Name">姓名</option>
					<option value="CreatedAt">创建时间</option>
				</select>
				<select asp-for="SortOrder">
					<option value="asc">升序</option>
					<option value="desc">降序</option>
				</select>
				<button type="submit">搜索</button>
			</form>
		</div>
	</div>

	<table id="userTable">
		<tr>
			<th>序号</th>
			<th>ID</th>
			<th>昵称</th>
			<th>姓名</th>
			<th>手机号</th>
			<th>身份证号</th>
			<th>身份证照片</th>
			<th>创建时间</th>
			<th>操作</th>
		</tr>
		<!-- 新增数据行 -->
		@* <tr id="newRow" style="display: none;">
		<form method="post" asp-page-handler="AddVehicle">
		<td>新增</td>
		<td>自动生成</td>
		<td><input type="text" name="NewUser.Nickname" placeholder="请输入昵称" /></td>
		<td><input type="text" name="NewUser.Name" placeholder="请输入姓名" /></td>
		<td><input type="text" name="NewUser.Phone" placeholder="请输入手机号" /></td>
		<td><input type="text" name="NewUser.IdentityCard" placeholder="请输入身份证号" /></td>
		<td>
		<!-- 隐藏文件输入框 -->
		<input type="file" id="fileInputAdd" name="NewVehicle.Image" accept="image/*" style="display: none;" />

		<!-- 自定义按钮 -->
		<button type="button" id="customButton">上传图片</button>

		<!-- 图片预览 -->
		<div id="previewContainer" style="margin-top: 10px;align-items: center; display:flex;flex-direction: column;">
		<img id="imagePreview" src="" style="display:none;width:100%;height:auto;" />
		<span id="fileName" style="display: block; color: #555; font-size: 14px;">未选择文件</span>
		</div>
		</td>



		<td>自动生成</td>
		<td>
		<button type="submit">保存</button>
		</td>
		</form>
		</tr> *@
		@for (int i = 0; i < Model.List.Count; i++) {
			<tr>
				<form method="post" asp-page-handler="UpdateUser" enctype="multipart/form-data">
				<td>@(i + 1)</td>
				<td>@Model.List[i].Id<input type="hidden" name="UpdatedUser.Id" value="@Model.List[i].Id" /></td>
				<td><input type="text" name="UpdatedUser.Nickname" value="@Model.List[i].Nickname" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.Name" value="@Model.List[i].Name" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.Phone" value="@Model.List[i].Phone" placeholder="无" disabled /></td>
				<td><input type="text" name="UpdatedUser.IdentityCard" value="@Model.List[i].IdentityCard" placeholder="无" disabled /></td>
				<td>
					<div class="imageContainer" data-id="@Model.List[i].Id">
						<!-- 当前图片 -->
						<img src="@Model.List[i].IdentityCardPictures" alt="图片加载失败"
							 style="width: 100px; height: auto; cursor: pointer;"
							 class="thumbnail"
							 data-id="@Model.List[i].Id"
							 onerror="this.style.display='none';">
						<input value="@Model.List[i].Id" id="userId" style="display:none;"/>
						<input type="file" id="@("fileInput"+ i)" name="file" style="display: none;" class="fileUpload" data-id="@Model.List[i].Id" required>
						<!-- 图片预览 -->
						<img src="" alt="预览图" class="preview" style="display: none; width: 100px; height: auto; margin-top: 10px;">
						<!-- 图片模态窗口 -->
						<div id="imageModal" class="modal" style="display:none;">
							<span class="close">&times;</span>
							<img class="modal-content" id="modalImage" />
						</div>
					</div>
				</td>

				<td>@Model.List[i].CreatedAt</td>

				<td>
					<button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
					<button type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="buttonClick()">保存</button>
				</td>

				<input type="hidden" name="UpdatedUser.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
				</form>
			</tr>
		}
		<script>
			const LENGTH = 10;
			var file;
			for (var i = 0; i < 10; i++) {
				document.getElementById('fileInput' + i).addEventListener('change', function (event) {
					if (event.target.files[0]) {
						file = event.target.files[0]; // 获取用户上传的文件
						console.log('myFile', file)
					}
				});
			}
			async function buttonClick() {
				const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

				console.log("开始调用接口...");
				fetch('/Admin/Subpages/UserManagement/UserOverview?handler=SayHello', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': token // 添加 CSRF Token
					},
				})
					.then(response => {
						if (!response.ok) {
							throw new Error(`HTTP 错误！状态码: ${response.status}`);
						}
						return response.json();
					})
					.then(data => {
						console.log("接口返回数据:", data);
						if (data.success) {
							alert("文件上传成功！\n" +
								"Image URL: " + data["imageUrl"] + "\n" +
								"File Path: " + data["filePath"]) + "\n:" + data;
						} else {
							alert("文件上传失败: " + (data.message || "未知错误"));
						}
						try {
							const data2 = new FormData();
							data2.append("key", data["filePath"]);
							data2.append("Signature", data["authorization"]);
							data2.append("x-cos-security-token", data["token"]);
							data2.append("x-cos-meta-fileid", data["cos_file_id"]);
							data2.append("file", file, file.name);
							try {
								const response = uploadFileSync(data["imageUrl"], data2);
								console.log("Upload success:", response);
							} catch (error) {
								console.error("Error during upload:", error);
							}
						} catch (error) {
							console.log("error" + error)
						}

					})

			}

			
		</script>

	</table>
	<div class="bottom">
		<div class="bottom-item">
			<text>第 @(Model.PageIndex) 页，共 * 页</text>
		</div>
		<div class="bottom-item">
			<input placeholder="请输入页数" />
			<button>跳转</button>
			<button>上一页</button>
			<button>下一页</button>
		</div>
	</div>



</body>
