@page
@model aspnetapp.Pages.Admin.Subpages.UserManagement.UserOverviewModel
@{
    ViewBag.Title = "用户总览";

}

<head>
    <meta charset="utf-8" />
    <title>用户总览</title>
    <!-- 引用外部 jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/table.css" />
    <script src="~/js/pageutils.js"></script>

</head>
<body>
    <h4>用户总览</h4>
    <!-- 显示错误消息 -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
        <div class="alert alert-danger">
            <ul>
                <text>@Model.ErrorMessage</text>
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- 显示成功消息 -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
        <div class="alert alert-success">
            <text>@Model.SuccessMessage</text>
            <text id="response"></text>

        </div>
    }

    <div class="header">
        <div class="header">
            <form method="get">
                <button type="submit">刷新</button>
            </form>
            <button>导出</button>
            <button id="addRowBtn">添加</button>
        </div>
        <form method="post" asp-page-handler="Search">
            <input asp-for="SearchPhone" placeholder="手机号" />
            <input asp-for="SearchName" placeholder="姓名" />
            <input asp-for="SearchNickname" placeholder="昵称" />
            <select asp-for="SortField">
                <option value="Id">ID</option>
                <option value="Phone">手机号</option>
                <option value="Name">姓名</option>
                <option value="CreatedAt">创建时间</option>
            </select>
            <select asp-for="SortOrder">
                <option value="asc">升序</option>
                <option value="desc">降序</option>
            </select>
            <button type="submit">搜索</button>
        </form>


        <button id="uploadButton">调用上传接口</button>

        <script>
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            document.getElementById('uploadButton').addEventListener('click', function () {
                console.log("开始调用接口...");
                fetch('/Admin/Subpages/UserManagement/UserOverview?handler=SayHello', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token // 添加 CSRF Token
                    },
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP 错误！状态码: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log("接口返回数据:", data);
                        if (data.success) {
                            alert("文件上传成功！\n" +
                                "Image URL: " + data.ImageUrl + "\n" +
                                "File Path: " + data.FilePath);
                        } else {
                            alert("文件上传失败: " + (data.message || "未知错误"));
                        }
                    })
                    .catch(error => {
                        console.error("调用接口失败:", error);
                        alert("接口调用失败，请查看控制台日志！");
                    });
            });

        </script>



    </div>

    </div>

    <table id="userTable">
        <tr>
            <th>序号</th>
            <th>ID</th>
            <th>昵称</th>
            <th>姓名</th>
            <th>手机号</th>
            <th>身份证号</th>
            <th>身份证照片</th>
            <th>创建时间</th>
            <th>操作</th>
        </tr>
        <!-- 新增数据行 -->
