@page
@model aspnetapp.Pages.Admin.Subpages.MiniProgramManagement.AnnouncementOverviewModel
@{
}

<head>
	<meta charset="utf-8" />
	<!-- 引用外部 jQuery -->
	<link rel="stylesheet" href="~/css/table.css" />
	<link rel="stylesheet" href="~/css/loading.css" />
	<!-- 引入 FontAwesome 图标库 -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
	<script src="/js/utils/jquery-3.6.0.min.js" defer></script>
	@* https://code.jquery.com/jquery-3.6.0.min.js *@
	<script src="~/js/loading.js" defer></script>
</head>
<header>
	<h3>公告总览</h3>
</header>
<body>

	<!-- 加载动画 -->
	<div class="box" id="loadding" style="display:none;">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<!-- 锁住页面的遮罩层 -->
	<div id="overlay" style="display:none;"></div>

	<!-- 显示错误消息 -->
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
		<div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
		@foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
			<div id="failMessage" class="failMessage">@error.ErrorMessage</div>
		}
		<script>
			setTimeout(function () {
				showMessage("failMessage", 4000);
			}, 500)
		</script>
	}

	<!-- 显示成功消息 -->
	@if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
		<div id="successMessage" class="message">@Model.SuccessMessage</div>
		<script>
			setTimeout(function () {
				showMessage("successMessage");
			}, 500)
		</script>
	}

	<div class="header">
		<div class="header">
			<form method="get">
				<button type="submit">刷新</button>
			</form>

			<button onclick="exportFile()" class="editBtn export">导出</button>
			<button onclick="showAddRowDataBtn()">添加</button>
		</div>
		<form method="post" asp-page-handler="Search">
            @* <input asp-for="SearchTheStoreHtml" id="SearchTheStoreHtml" value="" placeholder="门店ID" /> *@

			<select asp-for="SortField">
				<option value="Id">ID</option>
			</select>
			<select asp-for="SortOrder">
				<option value="asc">升序</option>
				<option value="desc">降序</option>
			</select>
			<button type="submit" onclick="confirmChangeSearchData()">搜索</button>
		</form>
	</div>
	<div class="table-container">
		<table id="userTable">
			<tr>
				<th>序号</th>
                @* <th>公告ID</th> *@
                <th>标题</th>
                <th>内容</th>
                <th>创建时间</th>
                <th>更新时间</th>
                <th>操作</th>
			</tr>
            <form method="post" asp-page-handler="Add">
			<td style="display:none;" id="autoGenerated1">自动生成</td>
            @* <td style="display:none;" id="autoGenerated2">自动生成</td> *@

            <td style="display:none;" id="Title">
                <input asp-for="NewAdvertisement.Title" />
                <span asp-validation-for="NewAdvertisement.Title"></span>
			</td>
            <td style="display:none;" id="Content">
                <input asp-for="NewAdvertisement.Content" />
                <span asp-validation-for="NewAdvertisement.Content"></span>
			</td>
            <td style="display:none;" id="autoGenerated3">自动生成</td>
            <td style="display:none;" id="autoGenerated4">自动生成</td>
            <td style="display:none;" id="submitButton">
				<button type="submit">添加</button>
			</td>
			</form>
			@for (int i = 0; i < Model.List.Count; i++) {
				<tr>
					<form method="post" asp-page-handler="Update" enctype="multipart/form-data">
					<td>@(i + 1)</td>
                    <td style="display:none;">
                        <span id="@("id" + i)">@Model.List[i].Id</span>
                        <input type="hidden" name="UpdatedNotice.Id" value="@Model.List[i].Id" />
                    </td>
                    <td><input id="@("Title" + i)" type="text" name="UpdatedNotice.Title" value="@Model.List[i].Title" placeholder="无" disabled style="width:100px;" /></td>
                    <td><textarea id="@("Content" + i)" type="text" name="UpdatedNotice.Content" value="@Model.List[i].Content" disabled style="width:200px;height:100px;">@Model.List[i].Content</textarea></td>

                    <td><span>@Model.List[i].CreatedAt</span></td>
                    <td><span>@Model.List[i].UpdatedAt</span></td>
                    <td>
						<button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
                        <button id="@("save" + i)" type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="saveClick(event)">保存</button>
						<button id="@("delete" + i)" type="button" class="deleteBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="confirmDelete(event)">删除</button>
					</td>

                    <input type="hidden" name="UpdatedNotice.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
					</form>
				</tr>
			}



		</table>

	</div>
    @if (Model.List.Count == 0){
        <span style="width: 100%;display:flex;justify-content: center;">当前页无任何数据!</span>
    }
	<div class="bottom">
		<div class="bottom-item">
			<text id="page">第 * 页</text>
			<text>，当前页共 @Model.List.Count 条数据</text>
			@if (@Model.SearchSum != 0) {
				<text>，共搜索到 @Model.SearchSum 条数据，</text>
			}

			<input id="PageCount" value="@Model.List.Count" style="display:none;" />
			<input id="PageLimit" value="@Model.Limit" style="display:none;" />

			<text id="pageSum"></text>
			<a href="#" id="pageSumButton" onclick="loadPageSum()" style="font-size:small;">显示总页数</a>
		</div>

		<div class="bottom-item">

			<form method="post" asp-page-handler="Search" it="pageForm">
				<input placeholder="请输入页数" id="redirect" />
                <button type="button" onclick="changePage(3)" class="editBtn">跳转</button>
                <button type="button" onclick="changePage(2)" class="editBtn">首页</button>
                <button type="button" onclick="changeEndPage()" class="editBtn">尾页</button>
                <button type="button" onclick="changePage(0)">上一页</button>
                <button type="button" onclick="changePage(1)">下一页</button>
                <span id="paginationTips" style="color: red; display: none; font-size: 14px; margin-top: 10px;"></span>
			</form>
		</div>
	</div>

	<script>
		// 页面加载完成后执行函数
		window.onload = function () {
			getSearchData();// 获取搜索框数据
			loadIndexPage();// 加载页码
			loadButton();// 加载按钮
		};
	</script>
	<script>

        const RESPONSEURL = `/Admin/Subpages/MiniProgramManagement/AdvertisingOverview`;
        const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const LENGTH = document.getElementById('PageCount').value;// 显示长度

        // 保存数据
        function saveClick(event) {
            loadHTML(); // 显示加载中
        }

        // 处理删除按钮点击事件
        async function confirmDelete(event) {

            // 弹出确认框
            const isConfirmed = confirm("确定要删除吗？");

            if (isConfirmed) {
                // 使用 event.target 获取被点击的按钮元素
                const button = event.target;
                // 获取 data-id 属性的值
                const deleteId = button.getAttribute('data-id');
                console.log('确认删除,ID:' + deleteId)
                loadHTML();
                const requestData = {
                    id: deleteId
                };
                console.log("requestData...", requestData);

                try {
                    const response = await fetch(`${RESPONSEURL}?handler=Del`, {
                        method: 'Delete',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': TOKEN // 添加 CSRF Token
                        },
                        body: JSON.stringify(requestData), // 将数据序列化为 JSON 格式
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP 错误！状态码: ${response.status}`);
                    }

                    const data = await response.json();  // 等待接口返回数据

                    if (data.success) {
                        console.log("删除成功，message:", data.message);
                        location.reload();

                    } else {
                        console.log("删除失败，message:", data.message);
                    }

                } catch (error) {
                    console.error("API 调用失败:", error);
                } finally {
                    cancelloadHTML();
                }

            }
        }

        // 添加一行数据
        function showAddRowDataBtn() {
            // 获取表单内所有的 <td> 元素
            const elementsToShow = [
                "autoGenerated1",
                // "autoGenerated2",
                "Title",
                "Content",
                "autoGenerated3",
                "autoGenerated4",
                "submitButton"
            ];

            elementsToShow.forEach(id => {
                const element = document.getElementById(id);
                if (element) {
                    element.style.display = "table-cell"; // 修改为适合的显示样式
                }
            });

        }

        // 更改页面*
        async function changePage(index) {
            try {
                loadHTML();

                const currentPage = await getIndexPage(); // 获取当前页码
                const totalPage = await getPageSum(); // 获取总页数

                let pageIndex = currentPage;

                if (index === 0) {
                    if (currentPage <= 1) {
                        showPaginationTip("已经是第一页！");
                        return; // 不执行后续逻辑
                    }
                    pageIndex = currentPage - 1;
                } else if (index === 1) {
                    if (currentPage >= totalPage) {
                        showPaginationTip("已经是最后一页！");
                        return; // 不执行后续逻辑
                    }
                    pageIndex = currentPage + 1;
                } else if (index === 2) {
                    pageIndex = 1; // 首页
                } else if (index > 2) {
                    const pageIndexRedirect = document.getElementById('redirect').value;
                    pageIndex = Math.min(totalPage, Math.max(1, parseInt(pageIndexRedirect))); // 输入跳转页
                }

                if (pageIndex !== currentPage) {
                    await confirmChangePage(pageIndex);
                } else {
                    console.warn("目标页码与当前页码相同，无需跳转。");
                }

            } catch (error) {
                console.error("更改页面失败:", error);
            } finally {
                cancelloadHTML();
            }
        }
        // 跳转到尾页*
        async function changeEndPage() {
            try {
                loadHTML();
                const totalPage = await getPageSum(); // 获取总页数
                await confirmChangePage(totalPage); // 跳转到尾页
            } catch (error) {
                console.error("跳转到尾页失败:", error);
            } finally {
                cancelloadHTML();
            }
        }


        // 确认修改页面*
        async function confirmChangePage(pageIndex) {
            const requestData = { PageIndex: pageIndex };

            try {
                const response = await fetch(`${RESPONSEURL}?handler=ChangePage`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN,
                    },
                    body: JSON.stringify(requestData),
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                // 获取表单元素
                var form = document.getElementById('pageForm');
                // 提交表单
                if (form) form.submit();
                const data = await response.json();
                if (data.success) {
                    console.log(`页面成功跳转到第 ${pageIndex} 页`);
                } else {
                    throw new Error(data.message || "未知错误");
                }
            } catch (error) {
                console.error("确认修改页面失败:", error);
                alert(`跳转失败：${error.message}`);
            }
        }

        // 获取当前页码*
        async function getIndexPage() {
            try {
                const response = await fetch(`${RESPONSEURL}?handler=PageIndex`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN,
                    },
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }

                const data = await response.json();
                if (data.success) {
                    return data.pageIndex;
                } else {
                    throw new Error(data.message || "无法获取当前页码");
                }
            } catch (error) {
                console.error("获取当前页码失败:", error);
                return 1; // 默认返回首页
            }
        }

        // 加载当前页面页码
        async function loadIndexPage() {
            const IndexPage = await getIndexPage();
            document.getElementById('page').textContent = `第 ${IndexPage} 页`;
        }

        // 导出文件
        async function exportFile() {
            window.location.href = `${RESPONSEURL}?handler=ExportToExcel`;

        }

        // 获取总页数*
        async function getPageSum() {
            try {
                const response = await fetch(`${RESPONSEURL}?handler=PageSum`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                });
                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();
                if (data.totalPages) {
                    return data.totalPages;
                } else {
                    throw new Error(data.message || "无法获取总页数");
                }
            } catch (error) {
                console.error("获取总页数失败:", error);
                return 1; // 默认总页数为 1
            }
        }


        // 加载总页数
        async function loadPageSum() {
            const pageSum = await getPageSum();
            // 更新总页数
            document.getElementById('pageSum').textContent = `共 ${pageSum} 页`;
            document.getElementById('pageSumButton').style.display = 'none';
        }

        // 加载按钮
        function loadButton() {
            // 获取所有文件上传控件
            const fileInputs = document.querySelectorAll(".fileUpload");

            fileInputs.forEach(input => {
                input.addEventListener("change", function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();

                        // 读取文件完成后设置预览图片的 src 属性
                        reader.onload = function (e) {
                            const preview = input.closest(".imageContainer").querySelector(".preview");
                            preview.src = e.target.result; // 设置预览图像的路径
                            preview.style.display = "block"; // 显示预览图片
                        };

                        // 读取文件为 Data URL
                        reader.readAsDataURL(file);
                    }
                });
            });

            // 编辑按钮逻辑
            const editButtons = document.querySelectorAll(".editBtn");
            editButtons.forEach(button => {
                button.addEventListener("click", function () {
                    const id = this.dataset.id;
                    console.log('id', id)
                    const container = document.querySelector(`.saveBtn[data-id="${id}"]`);

                    // 切换其他字段为可编辑状态
                    const inputs = container.closest("tr").querySelectorAll("input:not(.fileUpload)");
                    inputs.forEach(input => input.disabled = false);

                    // 使 textarea 可编辑
                    const textArea = container.closest("tr").querySelector(`textarea[name='UpdatedNotice.Content']`);
                    if (textArea) textArea.disabled = false; // 使 textarea 可编辑

                    // 切换按钮状态
                    this.style.display = "none"; // 隐藏编辑按钮
                    container.closest("tr").querySelector(".saveBtn").style.display = "inline-block";
                    container.closest("tr").querySelector(".deleteBtn").style.display = "inline-block";

                });
            });

        }


        // 获取搜索输入框的数据
        async function getSearchData() {
            var SearchTheStore = document.getElementById('SearchTheStoreHtml');

            try {
                const response = await fetch(`${RESPONSEURL}?handler=SearchData`, {
                    method: 'Get',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();

                if (data.success) {
                    console.log('getdata', data)
                    SearchTheStore.value = data.searchTheStore;
                    setTimeout(function () {
                        console.log('搜索成功!')
                    }, 500)
                } else {
                    alert(data.message + '请刷新页面后重试');
                }
            } catch (error) {
                console.error("API 调用失败:", error);
            } finally {
                cancelloadHTML();
            }
        }

        // 确认搜索
        async function confirmChangeSearchData() {
            loadHTML(); // 显示加载中            
            var SearchTheStore = document.getElementById('SearchTheStoreHtml').value

            const requestData = {
                "SearchTheStore": SearchTheStore,

            };
            console.log("requestData", requestData);
            try {
                const response = await fetch(`${RESPONSEURL}?handler=ChangeSearchData`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                    body: JSON.stringify(requestData),
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();
                if (data.success) {
                    getSearchData();
                } else {
                    alert(data.message + '请刷新页面后重试');
                }
            } catch (error) {
                console.error("API 调用失败:", error);
            } finally {
                cancelloadHTML();
            }
        }

	</script>

</body>