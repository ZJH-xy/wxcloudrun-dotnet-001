	<div class="bottom">
		<div class="bottom-item">
			<text id="page">第 1 页</text>
			<text>，当前页共 @Model.List.Count 条数据</text>
			@if (@Model.SearchSum != 0) {
				<text>，共搜索到 @Model.SearchSum 条数据，</text>
			}
			@* <text id="searchData" style="display:none;">，共搜索到 @Model.SearchSum 条数据，</text> *@

			<input id="PageCount" value="@Model.List.Count" style="display:none;" />
			<input id="PageLimit" value="@Model.Limit" style="display:none;" />

			<text id="pageSum"></text>
			<a href="#" id="pageSumButton" onclick="loadPageSum()" style="font-size:small;">显示总页数</a>
		</div>

		<div class="bottom-item">

			<form method="post" asp-page-handler="Search">
				<input placeholder="请输入页数" id="redirect" />
				<button onclick="changePage(3)" class="editBtn">跳转</button>
				<button onclick="changePage(2)" class="editBtn">首页</button>
				<button onclick="changeEndPage()" class="editBtn">尾页</button>
				<button onclick="changePage(0)">上一页</button>
				<button onclick="changePage(1)">下一页</button>

			</form>
		</div>
	</div>

	<script>
		// 页面加载完成后执行函数
