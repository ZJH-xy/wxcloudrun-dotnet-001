@page
@model aspnetapp.Pages.Admin.Subpages.OrderManagement.OrderOverviewModel
@{
}

<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/table.css" />
    <link rel="stylesheet" href="~/css/loading.css" />
    <!-- 引用外部 jQuery -->
    <script src="~/js/utils/jquery-3.6.0.min.js" defer></script>
    <script src="~/js/loading.js" defer></script>
</head>
<header>
    <h3>订单总览</h3>
</header>
<body>

    <!-- 加载动画 -->
    <div class="box" id="loadding" style="display:none;">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>
    <!-- 锁住页面的遮罩层 -->
    <div id="overlay" style="display:none;"></div>

    <!-- 显示错误消息 -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
        {
            <div id="failMessage" class="failMessage">@error.ErrorMessage</div>
        }
        <script>
            setTimeout(function () {
                showMessage("failMessage", 5000);
            }, 500)
        </script>
    }

    <!-- 显示成功消息 -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div id="successMessage" class="message">@Model.SuccessMessage</div>
        <script>
            setTimeout(function () {
                showMessage("successMessage", 5000);
            }, 500)
        </script>
    }

    <div class="header">
        <div class="header">
            <form method="get">
                <button type="submit">刷新</button>
            </form>
            <button onclick="exportFile()" class="editBtn export">导出</button>
            <input type="month" name="UpdatedOrder.exportFileTime" value="" placeholder="导出时间" />


        </div>
        <form method="post" asp-page-handler="Search">
            <input type="text" asp-for="SearchPlateNumberHtml" id="SearchPlateNumberHtml" value="" placeholder="搜索车牌号" />
            <input type="number" asp-for="SearchTheVehicleHtml" id="SearchTheVehicleHtml" value="" placeholder="搜索车辆ID" />
            <input type="number" asp-for="SearchTheRentalLocationHtml" id="SearchTheRentalLocationHtml" value="" placeholder="搜索门店ID" />
            <input type="text" asp-for="SearchStoreNameHtml" id="SearchStoreNameHtml" value="" placeholder="搜索门店名称" />
            <input type="number" asp-for="SearchUserPhoneHtml" id="SearchUserPhoneHtml" value="" placeholder="搜索手机号" />
            <select asp-for="SearchStatusHtml" id="SearchStatusHtml">
                <option value="">选择状态</option>
                <option value="已取消">已取消</option>
                <option value="待付款">待付款</option>
                <option value="已退款">已退款</option>
                <option value="待确认">待确认</option>
                <option value="进行中">进行中</option>
                <option value="已完成">已完成</option>
                <option value="付款中">付款中</option>
                <option value="退款中">退款中</option>
                <option value="侍补余">侍补余</option>
                <option value="已补余">已补余</option>
            </select>
            <select asp-for="SortFieldHtml" id="SortFieldHtml">
                <option value="Id">订单编号</option>
                <option value="ActualStartingTime">起始时间</option>
                <option value="ActualReturnTime">实际归还时间</option>
                <option value="SuccessTime">支付完成时间</option>
                <option value="CreatedAt">创建时间</option>
                <option value="UpdatedAt">更新时间</option>
            </select>
            <select asp-for="SortOrderHtml" id="SortOrderHtml">
                <option value="asc">升序</option>
                <option value="desc">降序</option>
            </select>
            <button type="submit" onclick="confirmChangeSearchData()">搜索</button>
        </form>
    </div>

    <div class="table-container">
        <table id="orderTable">
            <tr>
                <th>序号</th>
                <th>订单编号</th>
                <th>用户信息</th>
                <th>起始时间</th>
                <th>剩余时间</th>
                <th>实际归还时间</th>
                <th>租用车辆车牌号（ID）</th>
                <th>租车门店名称（ID）</th>
                <th>还车门店名称（ID）</th>
                <th>押金</th>
                <th>租金</th>
                <th>调度费</th>
                <th>超时费</th>
                <th>其他费用</th>
                <th>已付金额</th>
                <th>已退押金</th>
                <th>订单状态</th>
                <th>支付完成时间</th>
                <th>备注</th>
                <th>创建时间</th>
                <th>更新时间</th>
                <th>操作</th>
            </tr>
            @for (int i = 0; i < Model.List.Count; i++)
            {
                <tr>
                    <form method="post" asp-page-handler="UpdateOrder" enctype="multipart/form-data">
                    <td id="No_@(i + 1)" class="NoContainer">@(i + 1)</td>
                    <script>
                        // 加载序号
                        async function loadNo() {
                            const No = await getIndexPage(); // 获取序号的基础值
                            const spans = document.querySelectorAll('td.NoContainer'); // 查询所有的序号单元格

                            spans.forEach((span, index) => {
                                const newNumber = (No * 10 - 10) + index + 1; // 更新序号的逻辑
                                span.innerHTML = newNumber; // 设置新的序号
                                span.id = "No_" + newNumber; // 更新 ID 为新的序号
                            });
                        }
                        // 确保当文档加载完成后执行 loadNo
                        document.addEventListener('DOMContentLoaded', (event) => {
                            loadNo();
                        });
                    </script>
                    <td><span>@Model.List[i].Id</span><input type="hidden" name="UpdatedOrder.Id" value="@Model.List[i].Id" /></td>
                    <td>
                        <span>ID：@Model.List[i].TheUser</span><br>
                        @if (@Model.List[i].UserPhone != null){
                            <span>手机号：@Model.List[i].UserPhone</span><br>
                        }else{
                            <span>无</span>
                        }
                        @if (@Model.List[i].IdentityCard != null){
                            <span>身份证：@Model.List[i].IdentityCard</span>
                        }else{
                            <span>无</span>
                        }
                    </td>
                    <td>
                            @if (@Model.List[i].ActualStartingTime != null){
                                <span>@Model.List[i].ActualStartingTime</span>
                            }
                            else{
                                <span>未开始</span>
                            }
                    </td>
                    <td>
                            @if (Model.List[i].Timeout is TimeSpan time) {
                                if (time.TotalSeconds < 0) {
                                <span style="color:red">已超时 @time.Duration().ToString(@"hh\:mm\:ss")</span>
                                }
                                else {
                                <span style="color:green">剩余时间: @time.Duration().ToString(@"hh\:mm\:ss")</span>
                                }
                            }
                    </td>
                    <td>
                            @if (@Model.List[i].ActualReturnTime != null){
                                <span>@Model.List[i].ActualReturnTime </span>
                            }
                            else if (@Model.List[i].ActualStartingTime != null){
                                <span>未归还</span>
                            }
                            else{
                                <span>未开始</span>
                            }
                    </td>
                    <td>
                        <span>@Model.List[i].VehiclePlateNumber</span><br />
                        <span style="color:rgb(168,0,0)">(ID:@Model.List[i].TheVehicle)</span>
                    </td>
                    <td>
                            @if (@Model.List[i].TheRentalLocation != null){
                                <span>@Model.List[i].RentalLocationName </span><br />
                                <span style="color:rgb(168,0,0)">(ID:@Model.List[i].TheRentalLocation)</span>
                                 // RentalLocationName
                            }
                            else{
                            <span>无</span>
                            }
                    </td>
                    <td>
                            @if (@Model.List[i].TheReturnThePoint != null){
                                <span>@Model.List[i].ReturnThePointName</span><br />
                                <span style="color:rgb(168,0,0)">(ID:@Model.List[i].TheReturnThePoint)</span>
                                // ReturnThePointName
                            }
                            else if (@Model.List[i].ActualStartingTime != null){
                                <span>未归还</span>
                            }
                            else{
                                <span>无</span>
                            }
                    </td>
                    <td>
                        <span id="editSpan">@Model.List[i].Deposit</span>
                        <input id="inputSpan" type="number" name="UpdatedOrder.Deposit" value="@Model.List[i].Deposit" placeholder="请输入押金" step="0.01" style="display:none;width:100px;" disabled />
                    </td>
                    <td>
                        <span id="editSpan">@Model.List[i].Rent</span>
                        <input id="inputSpan" type="number" name="UpdatedOrder.Rent" value="@Model.List[i].Rent" placeholder="请输入租金" step="0.01" style="display:none;width:100px;" disabled />
                    </td>
                    <td><span>@Model.List[i].DispatchFee</span></td>
                    <td><span>@Model.List[i].OvertimeFee</span></td>
                    <td>
                        <span id="editSpan">@Model.List[i].OtherFees</span>
                        <input id="inputSpan" type="number" name="UpdatedOrder.OtherFees" value="@Model.List[i].OtherFees" placeholder="请输入其他费用" step="0.01"style=" display:none;width:100px;" disabled />
                    </td>
                    <td><span style="color:red;">@Model.List[i].Paid</span></td>
                    <td><span>@Model.List[i].DepositRefunded</span></td>
                    <td>
                        <input type="hidden" name="Status" value="@Model.List[i].Status" />
                        @switch (Model.List[i].Status){
                            case Order.EOrderStatus.已取消:
                            <span name="UpdatedVehicle.State" style="color:gray;">已取消</span>
                                break;

                            case Order.EOrderStatus.待付款:
                            <span name="UpdatedVehicle.State" style="color:orange;">待付款</span>
                                break;

                            case Order.EOrderStatus.已退款:
                            <span name="UpdatedVehicle.State" style="color:red;">已退款</span>
                                break;

                            case Order.EOrderStatus.待确认:
                            <span name="UpdatedVehicle.State" style="color:blue;">待确认</span>
                                break;

                            case Order.EOrderStatus.进行中:
                            <span name="UpdatedVehicle.State" style="color:green;">进行中</span>
                                break;

                            case Order.EOrderStatus.已完成:
                            <span name="UpdatedVehicle.State" style="color:purple;">已完成</span>
                                break;

                            case Order.EOrderStatus.付款中:
                            <span name="UpdatedVehicle.State" style="color:yellow;">付款中</span>
                                break;

                            case Order.EOrderStatus.退款中:
                            <span name="UpdatedVehicle.State" style="color:orange;">退款中</span>
                                break;

                            case Order.EOrderStatus.侍补余:
                            <span name="UpdatedVehicle.State" style="color:teal;">侍补余</span>
                                break;

                            case Order.EOrderStatus.已补余:
                            <span name="UpdatedVehicle.State" style="color:purple;">已补余</span>
                                break;

                            default:
                            <span name="UpdatedVehicle.State" style="color:black;">未知状态</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (@Model.List[i].SuccessTime != null){
                            <span id="@("SuccessTime" + i)">@Model.List[i].SuccessTime</span>
                        }
                        else{
                            <span>无</span>
                        }
                    </td>
                    <td>
                            @if (!string.IsNullOrEmpty(Model.List[i].Notes)){
                            <span id="editSpan" name="Notes">@Model.List[i].Notes</span> }
                            else
                            {
                            <span id="editSpan" name="Notes">无</span>
                            }
                        <textarea id="inputSpan" name="UpdatedOrder.Notes" style="display:none;width:100px;" disabled>@Model.List[i].Notes</textarea>
                    </td>
                    <td><span>@Model.List[i].CreatedAt</span></td>
                    <td><span>@Model.List[i].UpdatedAt</span></td>
                    <td>
                        <div id="message" class="warningMessage">
                            <div>
                                <span>提示：押金、租金和其他费用仅可在订单状态为</span>
                                <span style="color:red;">待付款、进行中和待补余</span>
                                <span>的情况下进行修改。</span>
                            </div>
                        </div>
                        <button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
                        <button id="@("save" + i)" type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;">保存</button>
                    </td>

                    <input type="hidden" name="UpdatedOrder.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
                    </form>
                </tr>
            }



        </table>

    </div>
    @if (Model.List.Count == 0){
        <span style="width: 100%;display:flex;justify-content: center;">当前页无任何数据!</span>
    }
    <div class="bottom">
        <div class="bottom-item">
            <text id="page">第 * 页</text>
            <text>，当前页共 @Model.List.Count 条数据</text>
@*             @if (@Model.SearchSum != 0)
            {
                <text>，共搜索到 @Model.SearchSum 条数据，</text>
            } *@

            <input id="PageCount" value="@Model.List.Count" style="display:none;" />
            <input id="PageLimit" value="@Model.Limit" style="display:none;" />

            <text id="pageSum"></text>
            <a href="#" id="pageSumButton" onclick="loadPageSum()" style="font-size:small;">显示总页数</a>
        </div>

        <div class="bottom-item">

            <form method="post" asp-page-handler="Search" id="pageForm">
                <input placeholder="请输入页数" id="redirect" />
                <button type="button" onclick="changePage(3)" class="editBtn">跳转</button>
                <button type="button" onclick="changePage(2)" class="editBtn">首页</button>
                <button type="button" onclick="changeEndPage()" class="editBtn">尾页</button>
                <button type="button" onclick="changePage(0)">上一页</button>
                <button type="button" onclick="changePage(1)">下一页</button>
                <span id="paginationTips" style="color: red; display: none; font-size: 14px; margin-top: 10px;"></span>

            </form>
        </div>
    </div>

    <script>
        // 页面加载完成后执行函数
        window.onload = function () {
            getSearchData();// 获取搜索框数据
            loadIndexPage();// 加载页码
            loadButton();// 加载按钮
        };
    </script>
    <script>

        const RESPONSEURL = `/Admin/Subpages/OrderManagement/OrderOverview`;
        const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const LENGTH = document.getElementById('PageCount').value;// 显示长度

        // 显示分页提示（支持自定义提示时长）
        function showPaginationTip(message, duration = 3000) {
            const tipElement = document.getElementById("paginationTips");
            if (tipElement) {
                tipElement.textContent = message;
                tipElement.style.display = "block";

                // 自动隐藏提示
                setTimeout(() => {
                    tipElement.style.display = "none";
                }, duration);
            }
        }

        // 更改页面*
        async function changePage(index) {
            try {
                loadHTML();

                const currentPage = await getIndexPage(); // 获取当前页码
                const totalPage = await getPageSum(); // 获取总页数

                let pageIndex = currentPage;

                if (index === 0) {
                    if (currentPage <= 1) {
                        showPaginationTip("已经是第一页！");
                        return; // 不执行后续逻辑
                    }
                    pageIndex = currentPage - 1;
                } else if (index === 1) {
                    if (currentPage >= totalPage) {
                        showPaginationTip("已经是最后一页！");
                        return; // 不执行后续逻辑
                    }
                    pageIndex = currentPage + 1;
                } else if (index === 2) {
                    pageIndex = 1; // 首页
                } else if (index > 2) {
                    const pageIndexRedirect = document.getElementById('redirect').value;
                    pageIndex = Math.min(totalPage, Math.max(1, parseInt(pageIndexRedirect))); // 输入跳转页
                }

                if (pageIndex !== currentPage) {
                    await confirmChangePage(pageIndex);
                } else {
                    console.warn("目标页码与当前页码相同，无需跳转。");
                }

            } catch (error) {
                console.error("更改页面失败:", error);
            } finally {
                cancelloadHTML();
            }
        }

        // 跳转到尾页
        async function changeEndPage(index) {
            try {
                const pageSum = await getPageSum();
                if (pageSum) {
                    console.log('pageSum', pageSum);
                    await confirmChangePage(pageSum);
                }
            } catch (error) {
                console.error('获取总页数失败:', error);
            }
        }

        // 确认修改页面*
        async function confirmChangePage(pageIndex) {
            const requestData = { PageIndex: pageIndex };

            try {
                const response = await fetch(`${RESPONSEURL}?handler=ChangePage`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN,
                    },
                    body: JSON.stringify(requestData),
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                // 获取表单元素
                var form = document.getElementById('pageForm');
                // 提交表单
                if (form) form.submit();
                const data = await response.json();
                if (data.success) {
                    console.log(`页面成功跳转到第 ${pageIndex} 页`);
                } else {
                    throw new Error(data.message || "未知错误");
                }
            } catch (error) {
                console.error("确认修改页面失败:", error);
                alert(`跳转失败：${error.message}`);
            }
        }

        // 获取当前页码*
        async function getIndexPage() {
            try {
                const response = await fetch(`${RESPONSEURL}?handler=PageIndex`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN,
                    },
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }

                const data = await response.json();
                if (data.success) {
                    return data.pageIndex;
                } else {
                    throw new Error(data.message || "无法获取当前页码");
                }
            } catch (error) {
                console.error("获取当前页码失败:", error);
                return 1; // 默认返回首页
            }
        }

        // 加载当前页面页码
        async function loadIndexPage() {
            const IndexPage = await getIndexPage();
            document.getElementById('page').textContent = `第 ${IndexPage} 页`;
        }

        // 导出文件
        async function exportFile() {
            loadHTML();
            const dateValue = document.querySelector('input[name="UpdatedOrder.exportFileTime"]').value;
            if (!dateValue) {
                alert('请选择时间');
                cancelloadHTML();
                return;
            }

            const requestData = {
                "Month": dateValue
            };
            console.log(requestData);

            try {
                const response = await fetch(`${RESPONSEURL}?handler=ExportToExcel`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                    body: JSON.stringify(requestData),
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }

                // 处理文件下载
                const blob = await response.blob(); // 将响应转换为 Blob 对象
                const url = window.URL.createObjectURL(blob); // 创建一个对象 URL
                const a = document.createElement('a'); // 创建一个链接元素
                a.href = url; // 设置链接的 href 为对象 URL
                a.download = '订单数据.xlsx'; // 设置下载文件名
                document.body.appendChild(a); // 将链接添加到文档中
                a.click(); // 模拟点击链接以下载文件
                a.remove(); // 下载后移除链接
                window.URL.revokeObjectURL(url); // 释放对象 URL

            } catch (error) {
                console.error('出错:', error);
            } finally {
                cancelloadHTML(); // 无论成功与否都取消加载动画
            }
        }
        
        // 获取总页数*
        async function getPageSum() {
            try {
                const response = await fetch(`${RESPONSEURL}?handler=PageSum`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                });
                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();
                if (data.totalPages) {
                    return data.totalPages;
                } else {
                    throw new Error(data.message || "无法获取总页数");
                }
            } catch (error) {
                console.error("获取总页数失败:", error);
                return 1; // 默认总页数为 1
            }
        }


        // 加载总页数
        async function loadPageSum() {
            const pageSum = await getPageSum();
            // 更新总页数
            document.getElementById('pageSum').textContent = `共 ${pageSum} 页`;
            document.getElementById('pageSumButton').style.display = 'none';
        }

        // 加载按钮
        function loadButton() {
            // 获取所有文件上传控件
            const fileInputs = document.querySelectorAll(".fileUpload");

            fileInputs.forEach(input => {
                input.addEventListener("change", function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();

                        // 读取文件完成后设置预览图片的 src 属性
                        reader.onload = function (e) {
                            const preview = input.closest(".imageContainer").querySelector(".preview");
                            preview.src = e.target.result; // 设置预览图像的路径
                            preview.style.display = "block"; // 显示预览图片
                        };

                        // 读取文件为 Data URL
                        reader.readAsDataURL(file);
                    }
                });
            });

            // 编辑按钮逻辑
            const editButtons = document.querySelectorAll(".editBtn");
            editButtons.forEach(button => {
                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    console.log('id', id)
                    const container = document.querySelector(`.saveBtn[data-id="${id}"]`);

                    const Status = container.closest("tr").querySelector(`input[name='Status']`);
                    const state = Status.value;
                    if (state != "待付款" && state != "进行中" && state != "待补余") {
                        // alert('押金、租金和其他费用仅可在订单状态为待付款、进行中和待补余的情况下进行修改。');
                        showMessage("message", 10000);
                        // 使 textarea 可编辑
                        const textArea = container.closest("tr").querySelector(`textarea[name='UpdatedOrder.Notes']`);
                        if (textArea) {
                            textArea.disabled = false; // 使 textarea 可编辑
                            textArea.style.display = "inline-block";  // 显示textArea

                        }
                        const textAreaSpan = container.closest("tr").querySelector(`span[name='Notes']`);
                        if (textAreaSpan) textAreaSpan.style.display = 'none';
                    } else {
                        // 切换其他字段为可编辑状态
                        const inputs = container.closest("tr").querySelectorAll("input:not(.fileUpload)");
                        inputs.forEach(input => input.disabled = false);

                        // 切换其他字段为可编辑状态
                        const spans = container.closest("tr").querySelectorAll("span");
                        const inputsToEnable = container.closest("tr").querySelectorAll("input, textarea");

                        // 只显示id为edit的span
                        spans.forEach(span => {
                            if (span.id === "editSpan") {
                                span.style.display = "none";  // 隐藏其他span
                            }
                        });

                        inputsToEnable.forEach(input => {
                            if (input.id === "inputSpan") {
                                input.disabled = false;      // 启用input
                                input.style.display = "inline-block";  // 显示input
                            }
                        });
                    }


                    // 切换按钮状态
                    this.style.display = "none"; // 隐藏编辑按钮
                    container.closest("tr").querySelector(".saveBtn").style.display = "inline-block";

                });
            });

        }

        // 打开模态窗口并加载点击的图片
        function openModal(imgElement) {
            var modal = document.getElementById("imageModal");
            var modalImg = document.getElementById("modalImage");

            // 设置模态窗口中的图片为当前点击的图片
            modal.style.display = "flex"; // 使用 flexbox 居中
            modalImg.src = imgElement.src; // 设置模态窗口图片源
        }

        // 关闭模态窗口
        function closeModal() {
            var modal = document.getElementById("imageModal");
            modal.style.display = "none";
        }

        // 如果点击模态窗口外部区域，关闭模态窗口
        window.onclick = function (event) {
            var modal = document.getElementById("imageModal");
            if (event.target === modal) {
                modal.style.display = "none";
            }
        }


        // 获取搜索输入框的数据
        async function getSearchData() {
            
            var SearchPlateNumber = document.getElementById('SearchPlateNumberHtml');
            var SearchTheVehicle = document.getElementById('SearchTheVehicleHtml');
            var SearchTheRentalLocation = document.getElementById('SearchTheRentalLocationHtml');
            var SearchStoreName = document.getElementById('SearchStoreNameHtml');
            var searchUserPhone = document.getElementById('SearchUserPhoneHtml');
            var searchStatus = document.getElementById('SearchStatusHtml');
            var sortField = document.getElementById('SortFieldHtml');
            var sortOrder = document.getElementById('SortOrderHtml');
            try {
                const response = await fetch(`${RESPONSEURL}?handler=SearchData`, {
                    method: 'Get',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();

                if (data.success) {
                    console.log('getdata', data)
                    setTimeout(function () {
                        SearchPlateNumber.value = data.searchPlateNumber;
                        SearchTheVehicle.value = data.searchTheVehicle;
                        SearchTheRentalLocation.value = data.searchTheRentalLocation;
                        SearchStoreName.value = data.searchStoreName;
                        searchUserPhone.value = data.searchUserPhone;
                        searchStatus.value = data.searchStatus;
                        sortField.value = data.sortField;
                        sortOrder.value = data.sortOrder;
                        console.log('搜索成功!')
                    }, 500)
                } else {
                    alert(data.message + '请刷新页面后重试');
                }
            } catch (error) {
                console.error("API 调用失败:", error);
            } finally {
                cancelloadHTML();
            }
        }

        // 确认搜索
        async function confirmChangeSearchData() {
            loadHTML(); // 显示加载中
            const SearchPlateNumberHtml = document.getElementById('SearchPlateNumberHtml').value;
            const SearchUserPhoneHtml = document.getElementById('SearchUserPhoneHtml').value;
            const SearchStatusHtml = document.getElementById('SearchStatusHtml').value;
            const SearchTheRentalLocationHtml = document.getElementById('SearchTheRentalLocationHtml').value;
            const SearchTheVehicleHtml = document.getElementById('SearchTheVehicleHtml').value;
            const SearchStoreNameHtml = document.getElementById('SearchStoreNameHtml').value;
            const SortFieldHtml = document.getElementById('SortFieldHtml').value;
            const SortOrderHtml = document.getElementById('SortOrderHtml').value;
            const requestData = {
                "SearchPlateNumber": SearchPlateNumberHtml,
                "SearchUserPhone": SearchUserPhoneHtml,
                "SearchStatus": SearchStatusHtml,
                "SearchTheVehicle": SearchTheVehicleHtml,
                "SearchTheRentalLocation": SearchTheRentalLocationHtml,
                "SearchStoreName": SearchStoreNameHtml,
                "SortField": SortFieldHtml,
                "SortOrder": SortOrderHtml,

            };
            console.log("requestData", requestData);
            try {
                const response = await fetch(`${RESPONSEURL}?handler=ChangeSearchData`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': TOKEN
                    },
                    body: JSON.stringify(requestData),
                });

                if (!response.ok) {
                    throw new Error(`HTTP 错误！状态码: ${response.status}`);
                }
                const data = await response.json();
                if (data.success) {
                    await getSearchData();
                } else {
                    alert(data.message + '请刷新页面后重试');
                }
            } catch (error) {
                console.error("API 调用失败:", error);
            } finally {
                cancelloadHTML();
            }
        }
    </script>

</body>
