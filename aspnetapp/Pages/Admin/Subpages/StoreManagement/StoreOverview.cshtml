@page
@model aspnetapp.Pages.Admin.Subpages.StoreManagement.StoreOverviewModel
@{

}



<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/loading.css" />
    <link rel="stylesheet" href="~/css/table.css" />
    <!-- 引入 FontAwesome 图标库 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <!-- 引用外部 jQuery -->
    <script src="/js/utils/jquery-3.6.0.min.js" defer></script>
    @* https://code.jquery.com/jquery-3.6.0.min.js *@
    <script src="~/js/loading.js" defer></script>
</head>
<header>
    <h3>门店总览</h3>
</header>
<body>

    <!-- 加载动画 -->
    <div class="box" id="loadding" style="display:none;">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>
    <!-- 锁住页面的遮罩层 -->
    <div id="overlay" style="display:none;"></div>

    <!-- 显示错误消息 -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
        {
            <div id="failMessage" class="failMessage">@error.ErrorMessage</div>
        }
        <script>
            setTimeout(function () {
                showMessage("failMessage", 4000);
            }, 500)
        </script>
    }

    <!-- 显示成功消息 -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div id="successMessage" class="message">@Model.SuccessMessage</div>
        <script>
            setTimeout(function () {
                showMessage("successMessage");
            }, 500)
        </script>
    }

    <div class="header">
        <div class="header">
            <form method="get">
                <button type="submit" onclick="init()">刷新</button>
            </form>

            <button onclick="exportFile()" class="editBtn export">导出</button>
            <button onclick="showAddRowDataBtn()">添加</button>
        </div>
        <form method="post" asp-page-handler="Search">
            @* 			<input asp-for="SearchPhoneHtml" id="SearchPhoneHtml" value="" placeholder="手机号" />
            <input asp-for="SearchNameHtml" id="SearchNameHtml" value="" placeholder="姓名" />
            <input asp-for="SearchNicknameHtml" id="SearchNicknameHtml" value="" placeholder="昵称" /> *@
            <select asp-for="SortField">
                <option value="Id">ID</option>
                <option value="Phone">手机号</option>
                <option value="Name">姓名</option>
                <option value="CreatedAt">创建时间</option>
                <option value="UpdatedAt">更新时间</option>
            </select>
            <select asp-for="SortOrder">
                <option value="asc">升序</option>
                <option value="desc">降序</option>
            </select>
            @* <div id="searchMessage" class="message">搜索成功</div> *@
            <button type="submit" onclick="confirmChangeSearchData()">搜索</button>
        </form>
    </div>
    <div class="table-container">

        <table id="userTable">
            <tr>
                <th>序号</th>
                <th>门店ID</th>
                <th>门店名称</th>
                <th>营业开始时间</th>
                <th>营业结束时间</th>
                <th>营业状态</th>
                <th>联系电话</th>
                <th>微信</th>
                <th>地址</th>
                <th>经度</th>
                <th>纬度</th>
                <th>图片</th>
                <th>门店介绍</th>
                <th>创建时间</th>
                <th>更新时间</th>
                <th>操作</th>
            </tr>
            <form method="post" asp-page-handler="AddStore">
            <td style="display:none;" id="autoGenerated1">自动生成</td>
            <td style="display:none;" id="autoGenerated2">自动生成</td>
            <td style="display:none;" id="inputName">
                <input asp-for="NewStore.Name" />
                <span asp-validation-for="NewStore.Name"></span>
            </td>
            <td style="display:none;" id="inputStartTime">
                <input asp-for="NewStore.BusinessHoursStart" type="time" />
                <span asp-validation-for="NewStore.BusinessHoursStart"></span>
            </td>
            <td style="display:none;" id="inputEndTime">
                <input asp-for="NewStore.BusinessHoursEnd" type="time" />
                <span asp-validation-for="NewStore.BusinessHoursEnd"></span>
            </td>
            <td style="display:none;" id="businessStatus">正常营业</td>
            <td style="display:none;" id="inputPhone">
                <input asp-for="NewStore.Telephone" />
                <span asp-validation-for="NewStore.Telephone"></span>
            </td>
            <td style="display:none;" id="inputWeChat">
                <input asp-for="NewStore.WeChat" />
            </td>
            <td style="display:none;" id="inputAddress">
                <input asp-for="NewStore.Address" />
            </td>
            <td style="display:none;" id="inputGpsLongitude">
                <input asp-for="NewStore.GpsLongitude" type="number" step="0.000001" />
            </td>
            <td style="display:none;" id="inputGpsLatitude">
                <input asp-for="NewStore.GpsLatitude" type="number" step="0.000001" />
            </td>
            <td style="display:none;" id="uploadStatus">添加成功后上传</td>
            <td style="display:none;" id="inputIntroduce">
                <textarea asp-for="NewStore.Introduce"></textarea>
            </td>
            <td style="display:none;" id="autoGenerated3">自动生成</td>
            <td style="display:none;" id="autoGenerated4">自动生成</td>
            <td style="display:none;" id="submitButton">
                <button type="submit">添加</button>
            </td>
            </form>



            @for (int i = 0; i < Model.List.Count; i++)
            {
                <tr>
                    <form method="post" asp-page-handler="UpdateUser" enctype="multipart/form-data" id="@("form" + i)">
                    <td>@(i + 1)</td>
                    <td><span id="@("id" + i)">@Model.List[i].Id</span><input type="hidden" name="UpdatedStore.Id" value="@Model.List[i].Id" /></td>
                    <td><input id="@("Name" + i)" type="text" name="UpdatedStore.Name" value="@Model.List[i].Name" placeholder="无" disabled /></td>
                    <td><input id="@("BusinessHoursStart" + i)" type="time" name="UpdatedStore.BusinessHoursStart" value="@Model.List[i].BusinessHoursStart" placeholder="无" disabled /></td>
                    <td><input id="@("BusinessHoursEnd" + i)" type="time" name="UpdatedStore.BusinessHoursEnd" value="@Model.List[i].BusinessHoursEnd" placeholder="无" disabled /></td>
                    <td>
                            @if (@Model.List[i].BusinessStatus)
                            {
                            <span style="color:#07C160;">正常营业</span>

                            }
                            else
                            {
                            <span style="color:red;">未营业</span>
                            }

                    </td>
                    <td><input id="@("Telephone" + i)" type="text" name="UpdatedStore.Telephone" value="@Model.List[i].Telephone" placeholder="无" disabled /></td>
                    <td><input id="@("WeChat" + i)" type="text" name="UpdatedStore.WeChat" value="@Model.List[i].WeChat" placeholder="无" disabled /></td>
                    <td><input id="@("Address" + i)" type="text" name="UpdatedStore.Address" value="@Model.List[i].Address" placeholder="无" disabled /></td>
                    <td><input id="@("GpsLongitude" + i)" type="text" name="UpdatedStore.GpsLongitude" value="@Model.List[i].GpsLongitude" placeholder="无" disabled /></td>
                    <td><input id="@("GpsLatitude" + i)" type="text" name="UpdatedStore.GpsLatitude" value="@Model.List[i].GpsLatitude" placeholder="无" disabled /></td>
                    <td>
                        <div class="imageContainer" data-id="@Model.List[i].Id">
                            <!-- 常驻显示的图片 -->
                            <div style="display:flex;align-items: center; justify-content: center; ">
                                <img src="" alt="图片加载失败"
                                     id="imageUrl"
                                     style="width: 100px; height: auto; cursor: pointer;display:none;"
                                     class="thumbnail"
                                     data-id="@Model.List[i].Id"
                                     onclick="openModal(this)">

                            </div>

                            <!-- 查看图片 -->
                                @if (!@Model.List[i].Pictures.IsNullOrEmpty())
                                {
                                <a href="#" id="@("getImageUrl" + i)" data-id="@Model.List[i].Pictures" onclick="loadImageUrl(event)">点击加载图片</a>
                                <div id="message" class="message">加载成功</div>

                                }
                                else
                                {
                                <span>无图片</span>
                                }
                            <!-- 修改图片 -->
                            <div style="display:flex;align-items: center; justify-content: center; ">
                                <input value="@Model.List[i].Id" id="userId" style="display:none;" />
                                <input type="file" id="@("fileInput"+ i)" value="true" name="file" style="display: none;" class="fileUpload" data-id="@Model.List[i].Id">
                            </div>
                            <div style="display:flex;align-items: center; justify-content: center; ">

                                <!-- 编辑的图片预览 -->
                                <img src="" alt="预览图" class="preview" style="display: none; width: 100px; height: auto; margin-top: 10px;">

                            </div>
                            <!-- 图片模态窗口 -->
                            <div id="imageModal" class="modal" style="display:none;">
                                <span class="close" onclick="closeModal()">&times;</span>
                                <img class="modal-content" id="modalImage" />
                            </div>
                        </div>
                    </td>
                    <td><textarea id="@("Introduce" + i)" type="text" name="UpdatedStore.Introduce" value="@Model.List[i].Introduce" disabled>@Model.List[i].Introduce</textarea></td>
                    <td><span id="@("createdAt" + i)">@Model.List[i].CreatedAt</span></td>
                    <td><span id="@("updatedAt" + i)">@Model.List[i].UpdatedAt</span></td>
                    <!-- 门店为true不显示 -->
                    <td style="display:none;">
                        <input id="@("IsDelete" + i)" type="hidden" name="UpdatedStore.IsDelete" value="false" />
                    </td>

                    <td>
                        <button type="button" class="editBtn" data-id="@Model.List[i].Id">编辑</button>
                        <button id="@("save" + i)" type="submit" class="saveBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="saveClick(event)">保存</button>
                        <button id="@("delete" + i)" type="button" class="deleteBtn" data-id="@Model.List[i].Id" style="display: none;" onclick="confirmDelete(event)">删除</button>
                    </td>

                    <input type="hidden" name="UpdatedStore.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
                    </form>
                </tr>
            }



        </table>
    </div>
    <div class="bottom">
        <div class="bottom-item">
            <text id="page">第 1 页</text>
            <text>，当前页共 @Model.List.Count 条数据</text>
            @if (@Model.SearchSum != 0)
            {
                <text>，共搜索到 @Model.SearchSum 条数据，</text>
            }
            @* <text id="searchData" style="display:none;">，共搜索到 @Model.SearchSum 条数据，</text> *@

            <input id="PageCount" value="@Model.List.Count" style="display:none;" />
            <input id="PageLimit" value="@Model.Limit" style="display:none;" />

            <text id="pageSum"></text>
            <a href="#" id="pageSumButton" onclick="loadPageSum()" style="font-size:small;">显示总页数</a>
        </div>

        <div class="bottom-item">

            <form method="post" asp-page-handler="Search">
                <input placeholder="请输入页数" id="redirect" />
                <button onclick="changePage(3)" class="editBtn">跳转</button>
                <button onclick="changePage(2)" class="editBtn">首页</button>
                <button onclick="changeEndPage()" class="editBtn">尾页</button>
                <button onclick="changePage(0)">上一页</button>
                <button onclick="changePage(1)">下一页</button>

            </form>
        </div>
    </div>

    <script>
        // 页面加载完成后执行函数
        window.onload = function () {
            getSearchData();// 获取搜索框数据
            loadIndexPage();// 加载页码
            loadButton();// 加载按钮
            document.addEventListener("DOMContentLoaded", () => {
                const form = document.getElementById("addRowData");
                form.style.display = "none"; // 确保加载时隐藏
            });
        };
    </script>
    <script src="~/js/utils/store.js"></script>

</body>
