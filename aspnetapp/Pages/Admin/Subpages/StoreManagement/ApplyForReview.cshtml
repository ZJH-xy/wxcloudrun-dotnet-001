@page
@model aspnetapp.Pages.Admin.Subpages.StoreManagement.ApplyForReviewModel
@{
}

<head>
	<meta charset="utf-8" />
	<!-- 引用外部 jQuery -->
	<link rel="stylesheet" href="~/css/table.css" />
	<link rel="stylesheet" href="~/css/loading.css" />
	<!-- 引入 FontAwesome 图标库 -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
	<script src="/js/utils/jquery-3.6.0.min.js" defer></script>
	@* https://code.jquery.com/jquery-3.6.0.min.js *@
	<script src="~/js/loading.js" defer></script>
</head>
<header>
	<h3>商家门店信息更改申请审核</h3>
</header>
<body>

	<!-- 加载动画 -->
	<div class="box" id="loadding" style="display:none;">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<!-- 锁住页面的遮罩层 -->
	<div id="overlay" style="display:none;"></div>

	<!-- 显示错误消息 -->
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
		<div id="failMessage" class="failMessage">@Model.ErrorMessage</div>
		@foreach (var error in ModelState.Values.SelectMany(v => v.Errors)) {
			<div id="failMessage" class="failMessage">@error.ErrorMessage</div>
		}
		<script>
			setTimeout(function () {
				showMessage("failMessage", 4000);
			}, 500)
		</script>
	}

	<!-- 显示成功消息 -->
	@if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
		<div id="successMessage" class="message">@Model.SuccessMessage</div>
		<script>
			setTimeout(function () {
				showMessage("successMessage");
			}, 500)
		</script>
	}

	<div class="table-container">
		<table id="Table">
			<tr>
				<th>序号</th>
				<th>ID</th>
				<th>门店ID</th>
				<th>名称</th>
				<th>地址</th>
				<th>经度</th>
				<th>纬度</th>
				<th>操作</th>
			</tr>
			@for (int i = 0; i < Model.List.Count; i++) {
				<tr>
					<form method="post" id="pageForm">
					<td>@(i + 1)</td>
					<td><span id="@("id" + i)">@Model.List[i].Id</span><input type="hidden" name="UpdatedStore.Id" value="@Model.List[i].Id" /></td>
					<td><span id="@("TheStore" + i)">@Model.List[i].TheStore</span></td>
					<td><input id="@("Name" + i)" type="text" name="UpdatedStore.Name" value="@Model.List[i].Name" /></td>
					<td><input id="@("Address" + i)" type="text" name="UpdatedStore.Address" value="@Model.List[i].Address" /></td>
					<td><span id="@("GpsLongitude" + i)">@Model.List[i].GpsLongitude</span></td>
					<td><span id="@("GpsLatitude" + i)">@Model.List[i].GpsLatitude</span></td>
					<td>
						<button id="@("Confirm " + i)" type="button" data-id="@Model.List[i].Id" onclick="confirm(@Model.List[i].Id)">确认</button>
						<button id="@("delete" + i)" type="button" class="deleteBtn" data-id="@Model.List[i].Id" onclick="cancel(@Model.List[i].Id)">取消</button>
					</td>

					<input type="hidden" name="UpdatedStore.RowVersion" value="@Convert.ToBase64String(@Model.List[i].RowVersion)" />
					</form>
				</tr>

			}
		</table>


	</div>
	<script>

		const RESPONSEURL = `/Admin/Subpages/StoreManagement/ApplyForReview`;
		const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]');

		// 确认
		async function confirm(id) {
			if (!TOKEN) {
				console.log("TOKEN为空！");
				return;
			}
			loadHTML();
			const requestData = {
				"id": id
			};
			console.log("requestData", requestData);
			try {
				const response = await fetch(`${RESPONSEURL}?handler=Confirm`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': TOKEN.value
					},
					body: JSON.stringify(requestData),
				});

				if (!response.ok) {
					throw new Error(`HTTP 错误！状态码: ${response.status}`);
				}
				const data = await response.json();

				if (data.success) {
					// 获取表单元素
					var form = document.getElementById('pageForm');
					// 提交表单
					if (form) {
						form.submit();
					}

				} else {
					alert(data.message);
				}
				cancelloadHTML();

			} catch (error) {
				cancelloadHTML()
				console.error("API 调用失败:", error);
			} 
		}
		async function cancel(id) {
			const isConfirmed = confirm("确定要删除吗？");
			if (!isConfirmed){
				return;
			}
			if (!TOKEN) {
				console.log("TOKEN为空！");
				return;
			}
			loadHTML();
			const requestData = {
				"id": id
			};
			console.log("requestData", requestData);
			try {
				const response = await fetch(`${RESPONSEURL}?handler=Refuse`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': TOKEN.value
					},
					body: JSON.stringify(requestData),
				});

				if (!response.ok) {
					throw new Error(`HTTP 错误！状态码: ${response.status}`);
				}
				const data = await response.json();

				if (data.success) {
					// 获取表单元素
					var form = document.getElementById('pageForm');
					// 提交表单
					if (form) {
						form.submit();
					}

				} else {
					alert(data.message);
				}
				cancelloadHTML();

			} catch (error) {
				cancelloadHTML()
				console.error("API 调用失败:", error);
			}
		}
	</script>
</body>